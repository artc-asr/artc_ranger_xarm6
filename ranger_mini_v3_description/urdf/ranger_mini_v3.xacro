<?xml version="1.0" encoding="utf-8"?>
<!--
  Ranger Mini 3.0 swerve-drive base, adapted from AgileX's upstream ROS1
  package (agilexrobotics/ugv_gazebo_sim, ranger_mini/ranger_mini_v3, urdf/
  ranger_mini.xacro) for use as a ROS 2 xacro macro:
    - Wrapped in xacro:macro name="ranger_mini_v3" params="prefix" (upstream
      is a flat, non-parameterized <robot> with no prefix support at all).
    - Every link/joint name and parent/child reference prefixed with
      ${prefix}, matching this workspace's convention (see
      ranger_xarm6.urdf.xacro, which expects xacro:ranger_mini_v3
      prefix="$(arg prefix)" and references ${prefix}base_link /
      ${prefix}*_steering_joint / ${prefix}*_wheel directly).
    - Mesh package:// URIs repointed from upstream's "ranger_mini_v3" to
      this package's actual name, "ranger_mini_v3_description".
    - The commented-out ROS1 <transmission>/<gazebo><plugin
      libgazebo_ros_control> block at the end of the upstream file (already
      inert there) was dropped entirely: this workspace supplies its own
      gz_ros2_control plugin block and RangerBaseState ros2_control
      interface in ranger_xarm6.urdf.xacro instead (see that file's
      comments for why: the wheels are left state-only/passive, driving is
      done kinematically by base_pose_publisher.py, not through
      ros2_control).
    Geometry, inertials, and joint limits are otherwise unchanged from
    upstream.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="ranger_mini_v3" params="prefix">

    <link name="${prefix}base_link">
      <inertial>
        <origin
          xyz="-0.0242698272228022 -0.0030308024613212 0.0544267444673498"
          rpy="0 0 0" />
        <mass
          value="10" />
        <inertia ixx="0.1354" ixy="0.0" ixz="0.0" iyy="0.2417" iyz="0.0" izz="0.3085"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0.0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://ranger_mini_v3_description/meshes/ranger_base.dae" scale="1000 1000 1000" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.1" rpy="0 0 0" />
        <geometry>
          <box size="0.5 0.35 0.2"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fr_steering_wheel_link">
      <inertial>
        <origin
          xyz="1.8493E-05 1.2713E-06 0.043679"
          rpy="0 0 0" />
        <mass
          value="1" />
        <inertia
          ixx="0.0063625"
          ixy="-1.0581E-07"
          ixz="-4.0831E-07"
          iyy="0.006363"
          iyz="-3.4944E-08"
          izz="0.010465" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/steering_wheel.dae" scale="10 10 10"/>
        </geometry>
        <material
          name="">
          <color
            rgba="0.79216 0.81961 0.93333 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.001" length="0.001"/>
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}fr_steering_joint"
      type="revolute">
      <origin
        xyz="0.25 -0.19 -0.1"
        rpy="0 0 0" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}fr_steering_wheel_link" />
      <axis
        xyz="0 0 -1" />
      <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
    </joint>

    <link name="${prefix}fr_wheel_link">
      <inertial>
        <mass value="8" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="3.14 0 0" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/wheel_v3.dae" scale="10 10 10"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 -0.005" rpy="1.57 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.09" />
        </geometry>
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </collision>
    </link>

    <joint name="${prefix}fr_wheel" type="continuous">
      <origin xyz="0.0 0.0 -0.12" rpy="0 0 0" />
      <parent link="${prefix}fr_steering_wheel_link"/>
      <child link="${prefix}fr_wheel_link"/>
      <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

    <link name="${prefix}fl_steering_wheel_link">
      <inertial>
        <origin
          xyz="-0.0017956 -9.6304E-08 0.043642"
          rpy="0 0 0" />
        <mass
          value="1" />
        <inertia
          ixx="0.0063695"
          ixy="-2.1067E-08"
          ixz="-0.00016867"
          iyy="0.006363"
          iyz="-1.0301E-08"
          izz="0.010458" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 3.14" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/steering_wheel.dae" scale="10 10 10"/>
        </geometry>
        <material
          name="">
          <color
            rgba="0.79216 0.81961 0.93333 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.001" length="0.001"/>
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}fl_steering_joint"
      type="revolute">
      <origin
        xyz="0.25 0.19 -0.1"
        rpy="0 0 0" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}fl_steering_wheel_link" />
      <axis
        xyz="0 0 -1" />
      <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
    </joint>

    <link name="${prefix}fl_wheel_link">
      <inertial>
        <mass value="8" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/wheel_v3.dae" scale="10 10 10"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 -0.005" rpy="1.57 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.09" />
        </geometry>
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </collision>
    </link>

    <joint name="${prefix}fl_wheel" type="continuous">
      <origin xyz="0.0 0.0 -0.12" rpy="0 0 0" />
      <parent link="${prefix}fl_steering_wheel_link"/>
      <child link="${prefix}fl_wheel_link"/>
      <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

    <link name="${prefix}rl_steering_wheel_link">
      <inertial>
        <origin
          xyz="-0.00017093 6.1255E-08 0.043678"
          rpy="0 0 0" />
        <mass
          value="1" />
        <inertia
          ixx="0.0063627"
          ixy="-2.1069E-08"
          ixz="-1.587E-05"
          iyy="0.006363"
          iyz="9.3201E-09"
          izz="0.010465" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 3.14" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/steering_wheel.dae" scale="10 10 10"/>
        </geometry>
        <material
          name="">
          <color
            rgba="0.79216 0.81961 0.93333 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.001" length="0.001"/>
        </geometry>
      </collision>
    </link>

    <joint
      name="${prefix}rl_steering_joint"
      type="revolute">
      <origin
        xyz="-0.25 0.19 -0.1"
        rpy="0 0 0" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}rl_steering_wheel_link" />
      <axis
        xyz="0 0 -1" />
      <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
    </joint>

    <link name="${prefix}rl_wheel_link">
      <inertial>
        <mass value="8" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/wheel_v3.dae" scale="10 10 10"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.00 0.00 -0.005" rpy="1.57 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.09" />
        </geometry>
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </collision>
    </link>

    <joint name="${prefix}rl_wheel" type="continuous">
      <origin xyz="0.0 0.0 -0.12 " rpy="0 0 0" />
      <parent link="${prefix}rl_steering_wheel_link"/>
      <child link="${prefix}rl_wheel_link"/>
      <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

    <link name="${prefix}rr_steering_wheel_link">
      <inertial>
        <origin xyz="0.0 0.0 0.0"/>
        <mass value="1"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/steering_wheel.dae" scale="10 10 10"/>
        </geometry>
      </visual>
      <collision>
        <origin  xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.001" length="0.001"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}rr_steering_joint" type="revolute">
      <origin xyz="-0.23 -0.206 -0.1" rpy="0 0 0" />
      <parent link="${prefix}base_link"/>
      <child link="${prefix}rr_steering_wheel_link"/>
      <axis xyz="0 0 -1" rpy="0 0 0" />
      <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
    </joint>

    <link name="${prefix}rr_wheel_link">
      <inertial>
        <mass value="8" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="3.14 0 0" />
        <geometry>
          <mesh filename="package://ranger_mini_v3_description/meshes/wheel_v3.dae" scale="10 10 10"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 -0.005" rpy="1.57 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.09" />
        </geometry>
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </collision>
    </link>

    <joint name="${prefix}rr_wheel" type="continuous">
      <origin xyz="0.0 0.0 -0.12 " rpy="0 0 0" />
      <parent link="${prefix}rr_steering_wheel_link"/>
      <child link="${prefix}rr_wheel_link"/>
      <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

  </xacro:macro>

</robot>
