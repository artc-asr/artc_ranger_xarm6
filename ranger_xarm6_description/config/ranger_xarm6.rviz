Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Color: 160; 160; 164
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Value: true

    # Relative topic 'robot_description' -- resolves under this node's own
    # namespace (rviz2 is launched with namespace=<robot_id>, see
    # ranger_xarm6.launch.py), same convention robotnik used before removal.
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: robot_description
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: ""
      Value: true

    # Global (not namespaced) topic -- matches wbcc_bringup/visualize_world.py
    # publishing the wall marker on the plain '/visualization_marker' topic.
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Wall Marker
      Topic:
        Value: /visualization_marker
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true

    # Global (not namespaced) topic -- matches wbcc_path/path_publisher.py,
    # which is launched without a namespace (see simulation.launch.py) the
    # same way Robotnik's own rviz_config.rviz displayed it (same topic,
    # same green) before that package was removed from this branch.
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Path
      Alpha: 1
      Buffer Length: 1
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Topic:
        Value: /path_topic
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true

    # Relative topics -- resolve under this node's own namespace (rviz2 is
    # launched with namespace=<robot_id>), same convention RobotModel above
    # uses. Matches the ROS-side topics ranger_xarm6.launch.py's
    # camera_bridge remaps the fixed_cam{1,2}/left_camera/right_camera/
    # wrist_camera sensors onto (sim) / their respective real drivers'
    # namespaces (real hardware).
    # All sensor displays (every PointCloud2/Image below except the non-
    # sensor Grid/TF/RobotModel/Marker/Path above) start Enabled: false,
    # per instruction -- nothing sensor-related is checked by default, the
    # viewer picks what they want to look at in the Displays panel rather
    # than everything rendering (and costing render time) at once.
    # Color Transformer: AxisColor (not RGB8) -- unlike Mid-360 (see
    # livox_ros_driver2/config/display_point_cloud_ROS2.rviz's own
    # PointCloud2, Color Transformer: Intensity), these points carry no
    # 'intensity' field (just x/y/z/rgb -- checked via `ros2 topic echo
    # .../depth/points --field fields`), so there's no lidar-style
    # reflectivity value to rainbow-color by. AxisColor/Z is the depth-camera
    # equivalent: colors by each point's Z in its OWN (Use Fixed Frame:
    # false) optical frame, i.e. straight-line distance from the camera --
    # same rainbow "heatmap" look, keyed to range instead of reflectivity.
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Fixed Cam 1 (depth heatmap)
      Topic:
        Value: fixed_cam1_camera/depth/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: false
      Autocompute Value Bounds:
        Value: true
      Use rainbow: true
      Invert Rainbow: false
      Value: false

    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Fixed Cam 2 (depth heatmap)
      Topic:
        Value: fixed_cam2_camera/depth/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: false
      Autocompute Value Bounds:
        Value: true
      Use rainbow: true
      Invert Rainbow: false
      Value: false

    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Fixed Cam 1 (color)
      Topic:
        Value: fixed_cam1_camera/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Fixed Cam 2 (color)
      Topic:
        Value: fixed_cam2_camera/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    # Real 2D depth map (gz-sim's actual depth buffer, same data the point
    # cloud is generated from) -- NOT 'fixed_cam{1,2}_camera/depth/image'
    # above, despite that name: that one is an rgb8 preview render, not
    # metric depth (see ranger_xarm6.launch.py's _FIXED_CAMERA_LEAVES
    # comment).
    # Normalize Range explicitly OFF, with a fixed Min/Max matching the
    # depth_camera's own near/far clip (0.1/10, see fixed_cam_sensor_tags
    # in ranger_xarm6.urdf.xacro) -- NOT left on Auto. gz-sim's rgbd_camera
    # fills any ray that never hits anything within the far clip with IEEE
    # +inf (confirmed: fixed_cam1, whose FOV is fully filled by
    # tested_world.world's wall, is 0% inf and displayed fine; fixed_cam2,
    # facing mostly open background, was 43% inf and rendered solid black).
    # Auto-normalize scans the buffer for its own min/max, so a single +inf
    # pixel makes that max infinity, collapsing every real finite pixel
    # toward zero/black -- a display-normalization artifact, not a wiring
    # or TF bug (the topic and its data were verified correct either way).
    # A fixed range sidesteps that scan entirely.
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Fixed Cam 1 (depth)
      Normalize Range: false
      Min Value: 0.1
      Max Value: 10
      Topic:
        Value: fixed_cam1_camera/depth/depth_image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Fixed Cam 2 (depth)
      Normalize Range: false
      Min Value: 0.1
      Max Value: 10
      Topic:
        Value: fixed_cam2_camera/depth/depth_image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    # Two SincereFirst USB camera modules (left_camera/right_camera, see
    # usb_camera_macro/usb_camera_sensor_tags in ranger_xarm6.urdf.xacro).
    # Plain RGB image_raw only -- no depth/point-cloud stream, unlike the
    # two D435i's above. Relative topics, same reasoning as every other
    # display here.
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Left Camera (USB)
      Topic:
        Value: left_camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Right Camera (USB)
      Topic:
        Value: right_camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    # Wrist camera (Orbbec Gemini 2, software-side; mesh still the D435i+
    # stand placeholder).
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Wrist Camera (depth heatmap)
      Topic:
        Value: wrist_camera/depth/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: false
      Autocompute Value Bounds:
        Value: true
      Use rainbow: true
      Invert Rainbow: false
      Value: false

    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Wrist Camera (color)
      Topic:
        Value: wrist_camera/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    # HiPNUC HI14R3-232-000 IMU (see hipnuc_imu_data_frame in
    # ranger_xarm6.urdf.xacro). Topic already carries a correct,
    # TF-resolvable frame_id (hipnuc_imu_sensor's own <gz_frame_id> tag).
    - Class: rviz_default_plugins/Imu
      Enabled: false
      Name: HiPNUC IMU
      Topic:
        Value: hipnuc_imu/data
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: false

    # Livox Mid-360 (see livox_frame in ranger_xarm6.urdf.xacro).
    # Color Transformer: Intensity, not AxisColor (unlike the depth
    # cameras' own PointCloud2 displays above) -- matches
    # livox_ros_driver2/config/display_point_cloud_ROS2.rviz's own
    # convention for this exact sensor: gz_lidar_to_pointcloud.py (sim)
    # and livox_ros_driver2 (real) both carry a real 'intensity' field,
    # unlike the depth cameras (no lidar-style reflectivity value there).
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Livox Mid-360
      Topic:
        Value: livox/lidar
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (Pixels): 3
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: true
      Use Fixed Frame: false
      Use rainbow: true
      Invert Rainbow: false
      Value: false

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: robot_a_odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.5
      Focal Point:
        X: 1
        Y: 0
        Z: 0.5
      Pitch: 0.4
      Yaw: 0.8
      Near Clip Distance: 0.01
      Invert Z Axis: false
      Target Frame: <Fixed Frame>
    Saved: ~

Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
  Displays:
    collapsed: false
  Views:
    collapsed: false
