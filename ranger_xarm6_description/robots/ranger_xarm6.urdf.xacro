<?xml version="1.0" encoding="utf-8"?>
<!--
  Ranger Mini 3.0 + xArm6 mobile manipulator description, used for both
  Gazebo Harmonic simulation and real hardware (see ranger_xarm6.launch.py,
  'sim' argument).

  Composes ranger_mini_v3_description (base) and xarm_description (arm),
  following the same "base macro + arm macro + fixed mount origin" pattern
  already used in this workspace for rbtheron_plus.urdf.xacro (see
  src/robotnik/robotnik_description/robots/rbtheron/rbtheron_plus.urdf.xacro).

  The arm's ros2_control interface ('arm_velocity_controller', see
  config/ros2_controllers.yaml) matches what wbcc_controller/wbc.py expects
  for Theron/Kairos's UR5e arm, so wbc.py needs no changes to drive this
  arm. The mobile base still has no ros2_control command interface for its
  wheels (only the state-only block below, for RobotModel/TF); real
  hardware drive is separate follow-up work
  (ranger_bringup/westonrobot_ranger_ros2, vendored, untested). Simulation
  driving IS wired up, just not through this URDF: see
  launch/ranger_xarm6.launch.py's base_pose_publisher.py, a kinematic
  (not physics-based) stand-in that integrates wbc.py's cmd_vel directly
  and teleports the Gazebo entity, bypassing wheel-level control entirely.
-->
<robot name="ranger_xarm6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="" />
  <!-- Undecorated robot_id (no trailing underscore), used only to namespace
       the Gazebo gz_ros2_control plugin block below; kept separate from
       'prefix' (which DOES have the trailing underscore baked in for link/
       joint names) because the plugin's <ros><namespace> tag wants a plain
       namespace segment, not a name-prefix string. -->
  <xacro:arg name="robot_namespace" default="" />
  <xacro:arg name="ros2_control_params" default="" />
  <!-- sim (default): gz_ros2_control/GazeboSimSystem. xarm_device_macro's
       own built-in gazebo-plugin support (load_gazebo_plugin) has no
       namespace option, so it's always left off here and we emit our own
       <gazebo><plugin> block below instead (with a <ros><namespace> tag),
       matching the pattern robotnik_description uses for Theron/Kairos:
       see src/robotnik/robotnik_description/simulators/gazebo_ignition/
       rbtheron/rbtheron_control.urdf.xacro.
       real hardware: ros2_control_plugin:=uf_robot_hardware/UFRobotSystemHardware,
       robot_ip:=<arm IP>; no Gazebo plugin involved either way.
       See ranger_xarm6.launch.py, sim:=false path. -->
  <xacro:arg name="ros2_control_plugin" default="gz_ros2_control/GazeboSimSystem" />
  <xacro:arg name="robot_ip" default="" />

  <!-- ====================================================================
       FT: base -> arm mount transform, corrected from Gazebo visual
       inspection after the STEP-derived heights kept turning out wrong.
       x=-0.2185 (from the mounting-plate geometry in
       RM_Version_1.2_production.step) checked out visually. z, however,
       was wrong at 0.25368 (mount plate height relative to the STEP CAD's
       "Ranger Mini 3.0" node origin), that STEP node's own origin isn't
       the same reference point as this package's base_link (base_link
       sits near the top of the chassis per ranger_mini_v3.xacro's
       collision box / visual mesh; the STEP node's origin is lower, deeper
       inside the chassis body), so the two aren't directly comparable
       without correcting for that offset. z set to 0.024 (24mm) per direct
       visual correction in Gazebo (arm was floating too high). Yaw set to
       180 degrees, also per visual correction. Still not a hardware
       measurement, treat as provisional until the real mount is
       physically measured or the arm's true orientation is confirmed
       against the ARTC handover note.
       Kept numerically in sync with arm_base_joint's origin in
       urdf/ranger_xarm6.urdf.
       ==================================================================== -->
  <xacro:property name="arm_mount_xyz" value="-0.218500 0.000000 0.024000" />
  <xacro:property name="arm_mount_rpy" value="0 0 3.141593" />

  <!-- ====================================================================
       FT: base_link -> xarm mount-plate visual (meshes/xarm_mount_plate.stl),
       derived from RM_Version_1.2_production.step. Unlike arm_mount_xyz/rpy
       above, this one is NOT independently visually corrected: it's
       arm_mount_xyz/rpy (base_link -> link_base, already trusted/tuned)
       composed with the STEP-measured link_base -> plate transform, i.e.
       "wherever the trusted arm mount is, the plate sits at this fixed
       offset from it" per CAD. That composition sidesteps the ranger's own
       STEP origin entirely (per-repo note: this STEP's Ranger Mini node is
       simplified and its origin doesn't line up with ranger_mini_v3.xacro's
       base_link), since both the plate and the arm hang off the same
       "Version_1.2_production_locked" assembly root and are properly
       mated to each other there. Purely a visual/collision addition (the
       xArm-Mounting plate on Ranger Mini node in STEP); it carries no new
       joint, base_link already accounts for the arm sitting at the height
       arm_mount_xyz/rpy implies.
       ==================================================================== -->
  <xacro:property name="mount_plate_xyz" value="-0.218500 0 0.02000" />
  <xacro:property name="mount_plate_rpy" value="0 0 -1.570796" />

  <!-- Base: Ranger Mini 3.0 -->
  <xacro:include filename="$(find ranger_mini_v3_description)/urdf/ranger_mini_v3.xacro" />
  <xacro:ranger_mini_v3 prefix="$(arg prefix)" />

  <!-- Arm: xArm6, mounted on the base via the placeholder FT above.
       model1300="true": this unit is the F/T-sensor-equipped "XI1300"
       variant (confirmed by RM_Version_1.2_production.step's own arm
       node name, "xArm6(XI1300)_02022023"), swaps link6's mesh from
       the plain xarm_description default to end_tool/visual/collision
       end_tool_1300.stl, xarm_description's actual model of the
       F/T-sensor-equipped tool flange (see xarm6.urdf.xacro's
       model_num >= 1300 branch).
       add_realsense_d435i="false": the wrist RealSense D435i (mesh,
       camera_depth/color/left_ir/right_ir frames, realsense_gz sensor
       plugin) is now built by hand below instead of by xarm_device_macro
       itself, so an explicit F/T sensor accessory (a cylinder, per
       instruction: no real F/T sensor mesh exists anywhere UFACTORY
       publishes it, end_tool_1300.stl above is link6's own tool-flange
       mesh, not a separate sensor body) can be inserted physically
       between link6's flange and the camera mount. xarm_device_macro.
       xacro's own joint_eef (link6 -> link_eef) hardcodes a 0 0 0 origin
       with no override parameter, so link_eef itself can't be pushed
       further from link6; instead, link_eef here is now a bare frame
       (xarm_device_macro's own "unless add_realsense_d435i" branch),
       and everything add_realsense_d435i="true" used to build
       automatically (camera mesh, camera_link and its children,
       realsense_gz's Sensors-system plugin registration) is recreated
       by hand below, parented past the new F/T sensor cylinder instead
       of directly at link_eef.
       Intended physical stack, per instruction: link6 (F/T-sensor-
       equipped flange mesh) -> F/T sensor accessory (new, below) ->
       camera -> gripper, in series. add_gripper is left false here on
       purpose: the G2 gripper is instead attached explicitly below,
       past camera_mount_link (see that link's own comment), because
       xarm_device_macro.xacro hardcodes the gripper's attach_xyz/
       attach_rpy at "0 0 0" with no parameter to override it from out
       here. Calling xarm_gripper_macro ourselves avoids touching the
       vendored xarm_ros2 submodule for this. -->
  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro" />
  <xacro:xarm_device
    prefix="$(arg prefix)"
    dof="6"
    robot_type="xarm"
    hw_ns="xarm"
    attach_to="$(arg prefix)base_link"
    attach_xyz="${arm_mount_xyz}"
    attach_rpy="${arm_mount_rpy}"
    create_attach_link="false"
    ros2_control_plugin="$(arg ros2_control_plugin)"
    ros2_control_params="$(arg ros2_control_params)"
    robot_ip="$(arg robot_ip)"
    load_gazebo_plugin="false"
    model1300="true"
    add_realsense_d435i="false"
    add_gripper="false"
  />

  <!-- common.link.xacro needs its own explicit include here:
       xarm_device_macro.xacro includes it too, but that's nested inside
       xarm_device's own macro body, so the macro definitions it provides
       (common_link_visual/common_link_collision, used by both the
       gripper below and camera_mount_link further down) don't leak out
       to this scope, unlike properties declared scope="parent". -->
  <xacro:include filename="$(find xarm_description)/urdf/common/common.link.xacro" />

  <!-- F/T sensor accessory cylinder: diameter=126mm/height=95mm per
       instruction, height along the flange direction (local Z, matching
       every other wrist-stack offset in this file: the gripper's own
       "0 0 0.003" below, d435i_urdf's own camera_link_joint, etc.).
       Placeholder mass/inertia (0.9kg, solid-cylinder formula): no real
       F/T sensor datasheet mass available, same treatment as the HiPNUC
       IMU's own placeholder inertial above. -->
  <link name="$(arg prefix)ft_sensor_link">
    <visual>
      <geometry>
        <cylinder radius="0.063" length="0.095" />
      </geometry>
      <material name="ft_sensor_grey">
        <color rgba="0.55 0.55 0.55 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.063" length="0.095" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.9" />
      <inertia ixx="0.00157" ixy="0" ixz="0" iyy="0.00157" iyz="0" izz="0.00179" />
    </inertial>
  </link>
  <joint name="$(arg prefix)ft_sensor_joint" type="fixed">
    <parent link="$(arg prefix)link_eef" />
    <child link="$(arg prefix)ft_sensor_link" />
    <origin xyz="0 0 0.0475" rpy="0 0 0" />
  </joint>

  <!-- Camera mount: exactly d435i_urdf's own link_eef body (same mesh,
       same visual/collision), just under a new name and parented past
       the F/T sensor cylinder instead of directly at link6's flange.
       xarm_gripper_macro attaches here now (past this mesh's own 30mm
       depth, matching the pre-existing "0 0 0.003" offset unchanged,
       since that offset is relative to the mesh's own geometry, not to
       whichever frame the mesh happens to be bolted to). -->
  <link name="$(arg prefix)camera_mount_link">
    <xacro:common_link_visual
      mesh_filename="camera/realsense/visual/d435_with_cam_stand"
      origin_xyz="0 0 0"
      origin_rpy="0 0 0"
      material_name="$(arg prefix)Silver" />
    <xacro:common_link_collision
      mesh_filename="camera/realsense/collision/d435_with_cam_stand"
      origin_xyz="0 0 0"
      origin_rpy="0 0 0" />
  </link>
  <joint name="$(arg prefix)camera_mount_joint" type="fixed">
    <parent link="$(arg prefix)ft_sensor_link" />
    <child link="$(arg prefix)camera_mount_link" />
    <origin xyz="0 0 0.0475" rpy="0 0 0" />
  </joint>

  <!-- Exact same frames d435i_urdf's own macro (xarm_description/urdf/
       camera/realsense_d435i.urdf.xacro) creates when add_d435i_links is
       on, hand-copied here (not xacro:include'd a second time: that
       macro hardcodes its mesh-carrying link's own name to
       "${prefix}link_eef", which would collide with the bare link_eef
       xarm_device_macro still creates above). Same names, same relative
       offsets as that macro's own body, only the top parent changed
       (camera_mount_link, not link_eef): every existing downstream
       reference to these frame names (wrist_camera_sensor_tags,
       orbbec_gemini2_extrinsics, RViz, ranger_xarm6.launch.py's wrist
       camera bridge) keeps working unchanged. -->
  <link name="$(arg prefix)camera_link"></link>
  <link name="$(arg prefix)camera_depth_frame"></link>
  <link name="$(arg prefix)camera_depth_optical_frame"></link>
  <link name="$(arg prefix)camera_color_frame"></link>
  <link name="$(arg prefix)camera_color_optical_frame"></link>
  <link name="$(arg prefix)camera_left_ir_frame"></link>
  <link name="$(arg prefix)camera_left_ir_optical_frame"></link>
  <link name="$(arg prefix)camera_right_ir_frame"></link>
  <link name="$(arg prefix)camera_right_ir_optical_frame"></link>
  <joint name="$(arg prefix)camera_link_joint" type="fixed">
    <parent link="$(arg prefix)camera_mount_link" />
    <child link="$(arg prefix)camera_link" />
    <origin xyz="0.06746 -0.0175 0.0237" rpy="${pi} ${-pi/2} 0" />
  </joint>
  <joint name="$(arg prefix)camera_depth_joint" type="fixed">
    <parent link="$(arg prefix)camera_link" />
    <child link="$(arg prefix)camera_depth_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="$(arg prefix)camera_depth_optical_joint" type="fixed">
    <parent link="$(arg prefix)camera_depth_frame" />
    <child link="$(arg prefix)camera_depth_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>
  <joint name="$(arg prefix)camera_color_joint" type="fixed">
    <parent link="$(arg prefix)camera_link" />
    <child link="$(arg prefix)camera_color_frame" />
    <origin xyz="0 0.015 0" rpy="0 0 0" />
  </joint>
  <joint name="$(arg prefix)camera_color_optical_joint" type="fixed">
    <parent link="$(arg prefix)camera_color_frame" />
    <child link="$(arg prefix)camera_color_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>
  <joint name="$(arg prefix)camera_left_ir_joint" type="fixed">
    <parent link="$(arg prefix)camera_link" />
    <child link="$(arg prefix)camera_left_ir_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="$(arg prefix)camera_left_ir_optical_joint" type="fixed">
    <parent link="$(arg prefix)camera_left_ir_frame" />
    <child link="$(arg prefix)camera_left_ir_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>
  <joint name="$(arg prefix)camera_right_ir_joint" type="fixed">
    <parent link="$(arg prefix)camera_link" />
    <child link="$(arg prefix)camera_right_ir_frame" />
    <origin xyz="0 -0.050 0" rpy="0 0 0" />
  </joint>
  <joint name="$(arg prefix)camera_right_ir_optical_joint" type="fixed">
    <parent link="$(arg prefix)camera_right_ir_frame" />
    <child link="$(arg prefix)camera_right_ir_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- G2 gripper, attached explicitly here (not via xarm_device's own
       add_gripper) so it can be offset past camera_mount_link's own
       30mm mesh depth instead of overlapping it; see the comment on the
       xarm_device call above. Same macro xarm_device would have called
       internally; ros2_control_plugin/dof match what was passed there,
       hard_interface left at its default (PositionJointInterface,
       matching effort_control=false/velocity_control=false,
       xarm_device's own defaults, which the arm above also used). -->
  <xacro:include filename="$(find xarm_description)/urdf/gripper/xarm_gripper_macro.xacro" />
  <xacro:xarm_gripper_macro
    prefix="$(arg prefix)"
    attach_to="$(arg prefix)camera_mount_link"
    attach_xyz="0 0 0.003"
    attach_rpy="0 0 0"
    ros2_control_plugin="$(arg ros2_control_plugin)"
    dof="6"
    gripper_version="G2"
  />

  <!-- Arm-to-base mounting plate (visual/collision only, no new joint):
       the physical bracket the xArm6 bolts to on top of the Ranger, per
       RM_Version_1.2_production.step's "xArm-Mounting plate on Ranger
       Mini" node. Missing from Gazebo until now; the fixed transform above
       (arm_mount_xyz/rpy) already accounted for its effect on the arm's
       pose, this just makes it visible/collidable too. -->
  <link name="$(arg prefix)mount_plate_link">
    <visual>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/xarm_mount_plate.stl" />
      </geometry>
      <material name="mount_plate_grey">
        <color rgba="0.6 0.6 0.6 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/xarm_mount_plate.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
  </link>
  <joint name="$(arg prefix)mount_plate_joint" type="fixed">
    <parent link="$(arg prefix)base_link" />
    <child link="$(arg prefix)mount_plate_link" />
    <origin xyz="${mount_plate_xyz}" rpy="${mount_plate_rpy}" />
  </joint>

  <!-- Camera rig + leftover shapes from RM_Version_1.2_production.step,
       under its root assembly ("Version_1.2_production_locked"): the
       "Camera_module_for_design" subtree (USB_Camera_module /
       Realsense_Camera_module x2 + Top_plate_blank + Component104,
       previously found floating unmated near the STEP origin) and the
       root-level anonymous "leftover free shape" bucket FreeCAD's STEP
       importer collects there (labelled COMPOUND004 in this FreeCAD
       import; a different CAD tool may number/name it differently, e.g.
       "Compound031", same node). All individual fastener/screw PRODUCT
       instances (10 of them, at the assembly root) are deliberately
       excluded, per instruction. Merged into one mesh; the actual root
       cause of Top_plate_blank looking disconnected from its mounting
       bracket in Gazebo (a "floating panel") turned out to be FreeCAD's
       own STEP-to-mesh tessellation specifically, not decimation and not
       a seam/vertex-welding problem: confirmed by tessellating Compound031
       alone (no merging, no decimation, full fidelity) through two other
       OpenCASCADE-based pipelines (CadQuery/OCP and raw pythonocc-core)
       and comparing all three; only FreeCAD's output showed the gap
       (pythonocc-core's run even logged it outright: "8 faces have been
       skipped due to null triangulation"). So this mesh is now generated
       via CadQuery instead: FreeCAD is still used to navigate the STEP
       assembly tree and select/isolate this bundle's shapes by label (a
       different problem, unaffected by this), re-exported losslessly as
       a standalone intermediate STEP (pure BREP, no tessellation), then
       CadQuery reads THAT and does the actual meshing (0.05mm linear /
       0.3 angular tolerance) and STL export: 122.5k faces, 5.8MB. (mm ->
       m unit conversion and the bbox-center recentering below were done
       as a pure vertex-scale/translate on the already-tessellated
       triangle data, not via CadQuery's own Shape.scale(), because
       combining scale() with export bloated the file to 150+MB:
       non-uniform-looking OCCT transforms can force simple analytic
       surfaces (cylinders etc.) into more general BSpline
       representations before meshing, producing far more triangles for
       the same nominal tolerance.) Positioned the same way as
       mount_plate_xyz/rpy above: this bundle's merged bounding-box
       center, taken as a world-axis-aligned point (no rotation applied
       beyond that), expressed relative to the xArm-Mounting plate's own
       native STEP origin and then composed with mount_plate_xyz/rpy
       (itself trusted/tuned now), verified by reconstructing the merged
       mesh's points through this exact transform and overlaying them back
       onto the original STEP geometry (matched), and confirmed the
       fastener exclusion doesn't change this position (they sat within
       the bounding box already). That's a placement, not a mounting
       relationship, though: this bundle was NOT assembly-mated to
       anything in the CAD (it sat parked near the STEP file's origin,
       across multiple unresolved design variants: v1/v2/Mirror, per
       the "for_design" folder it came from), so treat this link's
       position as "reproduces where the STEP file happened to leave it,
       converted into base_link's frame" rather than a measured or
       verified real-world mounting location. -->
  <xacro:property name="extras_xyz" value="0.1435 0 0.2095" />
  <xacro:property name="extras_rpy" value="0 0 -1.570796" />
  <link name="$(arg prefix)extras_link">
    <visual>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/extras_compressed.stl" />
      </geometry>
      <material name="extras_grey">
        <color rgba="0.5 0.5 0.55 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/extras_compressed.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
  <joint name="$(arg prefix)extras_joint" type="fixed">
    <parent link="$(arg prefix)base_link" />
    <child link="$(arg prefix)extras_link" />
    <origin xyz="${extras_xyz}" rpy="${extras_rpy}" />
  </joint>

  <!-- HiPNUC HI14R3-232-000 (9-axis IMU/AHRS: 3-axis gyro + 3-axis accel +
       3-axis magnetometer, "R3" grade, RS-232, M12 connector variant),
       mounted on top of extras_link. Real dimensions/mounting pulled from
       HiPNUC's own HI14 datasheet (docs.hipnuc.com, rev 1.7): M12 variant
       is 40 x 58.50 x 20mm, 4x d3.20mm mounting holes on a 34 x 39mm
       pattern, M3 fixing screws, aluminum housing, <75g. No downloadable
       mesh/CAD exists from HiPNUC publicly (checked: not in the datasheet,
       not in their Python/C++ product SDKs on GitHub, "3D Step" is listed
       under "Related Documents" but isn't a direct link): placeholder
       box using these real measured dimensions, same treatment as the two
       USB camera modules above.

       "On top of extras_link" computed from that mesh's own actual
       bounding box (extras_compressed.stl), not guessed: parsed the
       binary STL directly (min/max vertex Z), giving a local Z half-span
       of 0.2095m around the mesh's own centered origin, matching
       extras_xyz's own Z (0.2095), itself derived the same "STEP bbox-
       center" way per that property's own comment above. So the mesh's
       real top surface sits at 0.2095 (extras_xyz.z) + 0.2095 (mesh half-
       height) = 0.4190 in base_link's frame, nominally 0.2195 local Z
       relative to extras_link (0.2095 mesh half-height + 0.010 half the
       IMU's own 20mm height); extras_rpy's own yaw doesn't change this (a
       pure Z-axis rotation leaves Z spans alone), so this holds
       regardless of any future retuning of extras_xyz/rpy's X/Y or yaw
       specifically (only a change to extras_xyz's own Z, or a mesh
       replacement, would need this height revisited).
       hipnuc_imu_xyz's actual value, "0 0.04 0.2205", is hand-tuned off
       that nominal "0 0 0.2195": a small manual Z clearance bump plus a
       4cm Y offset, both mounting-position choices, not re-derived here.

       Two frames, same physical-mount/native-sensor-axes split used
       throughout this file for camera optical frames:
       hipnuc_imu_link: the MOUNT frame (hosts the visual/collision box).
       Positioned at extras_link's top surface + half the IMU's own 20mm
       height (0.2095+0.2095+0.010=0.4290 local Z relative to extras_link,
       whose own origin is already at that 0.2095 height above base_link).
       Rotated +90 deg yaw relative to extras_link (which itself carries a
       -90deg yaw, extras_rpy) so hipnuc_imu_link ends up identity-aligned
       with base_link (REP103 X-forward/Y-left/Z-up): a deliberate
       mounting CHOICE (nothing forces this), picked so "IMU nose (see
       below) points at the robot's own front" is the default; revisit
       this rotation if the real unit ends up mounted facing another way.
       hipnuc_imu_data_frame: the SENSOR's own native axis convention,
       child of hipnuc_imu_link. Per the datasheet's own "10 Coordinate
       System" section (Figure 30) the HI14 body axes are Right-Forward-Up
       (X=right, Y=forward/"nose", Z=up), NOT REP103's Forward-Left-Up:
       a plain yaw won't reconcile the two on its own; the exact rotation
       (-90deg yaw) is derived in the sensor-tags comment below where it's
       actually used, since it's identical to the one this frame's own
       joint applies. This is the frame the real sensor_msgs/Imu data
       (both sim and the real HiPNUC ROS driver) should use as
       header.frame_id; it, not hipnuc_imu_link, is what the sensor's
       raw axes actually match. -->
  <xacro:property name="hipnuc_imu_xyz" value="0 0.04 0.2205" />
  <xacro:property name="hipnuc_imu_rpy" value="0 0 1.570796" />
  <link name="$(arg prefix)hipnuc_imu_link">
    <visual>
      <geometry>
        <!-- X=0.0585 (58.5mm, sensor's own Y/"nose-tail" length, aligned
             to this frame's own X/forward per the mounting choice above),
             Y=0.040 (40mm width), Z=0.020 (20mm height): the M12
             variant's real datasheet envelope, not the case's true
             external shape (M12 connector stub not separately modeled). -->
        <box size="0.0585 0.040 0.020" />
      </geometry>
      <material name="hipnuc_imu_grey">
        <color rgba="0.7 0.7 0.72 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.0585 0.040 0.020" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.075" />
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002" />
    </inertial>
  </link>
  <joint name="$(arg prefix)hipnuc_imu_joint" type="fixed">
    <parent link="$(arg prefix)extras_link" />
    <child link="$(arg prefix)hipnuc_imu_link" />
    <origin xyz="${hipnuc_imu_xyz}" rpy="${hipnuc_imu_rpy}" />
  </joint>
  <link name="$(arg prefix)hipnuc_imu_data_frame" />
  <joint name="$(arg prefix)hipnuc_imu_data_joint" type="fixed">
    <parent link="$(arg prefix)hipnuc_imu_link" />
    <child link="$(arg prefix)hipnuc_imu_data_frame" />
    <origin xyz="0 0 0" rpy="0 0 -1.570796" />
  </joint>

  <!-- Livox Mid-360 3D LIDAR (360deg horizontal, non-repetitive scanning),
       mounted on extras_link. Nominal placement was "30mm above the
       joint position of the IMU": same X/Y as hipnuc_imu_xyz, Z =
       hipnuc_imu_xyz's own 0.2205 + 0.030 = 0.2505; livox_mid360_xyz's
       actual value, "0 0.04 0.2805", is hand-tuned another 0.030 higher
       than that nominal (same X/Y), a mounting-position choice, not
       re-derived here (same treatment as hipnuc_imu_xyz's own hand-tuned
       value above).
       Real mesh (not a placeholder box, unlike the IMU): copied from a
       sibling workspace's robotnik_sensors package (meshes/3d_lidar/
       livox_mid_360.stl), which Robotnik ships in production for the
       same Mid-360 unit on their own robots: own copy here since this
       repo can't depend on a package from an unrelated workspace.
       Two frames, same mount/native-origin split as the IMU above:
       livox_mid360_link: MOUNT frame (hosts the mesh). livox_mid360_rpy
       is hand-tuned to "0 0 -1.570796" (same -90deg yaw as extras_rpy,
       not cancelling it): combined with extras_link's own -90deg yaw,
       livox_mid360_link ends up rotated 180deg in yaw relative to
       base_link, NOT identity-aligned the way hipnuc_imu_link and Weston
       Robot's own reference mount (github.com/westonrobot/
       wr_devkit_mapping's robot.urdf.xacro: livox_joint, zero rotation
       relative to base_link) are: a deliberate mounting-orientation
       choice (e.g. connector/cable routing direction), not re-derived
       here. Since the Mid-360 scans the full 360deg horizontally, this
       yaw choice doesn't affect scan coverage, only which horizontal
       angle in the raw scan corresponds to the robot's own front. Mesh
       visual/collision origin rpy="1.57 0 0" and scale 0.001 are real,
       Robotnik-measured mesh-alignment facts (STL authored in mm, needs
       a 90deg roll to sit upright), not guessed.
       livox_frame: the SENSOR's own real point-cloud origin, child of
       livox_mid360_link, offset +0.0365 in local Z: also a real
       Robotnik-measured value (their own sensor_livox_mid_360 macro's
       ${frame_prefix}joint). Named "livox_frame" (not "livox_mid360_
       frame"), unprefixed-matching Weston Robot's own robot.urdf.xacro
       AND livox_ros_driver2's own default 'frame_id' ROS param and
       LIO-SAM's default 'lidarFrame' config value, for drop-in
       compatibility with their mapping/nav stacks later if ever vendored
       here (wr_devkit_mapping, wr_devkit_navigation). -->
  <xacro:property name="livox_mid360_xyz" value="0 0.04 0.2805" />
  <xacro:property name="livox_mid360_rpy" value="0 0 -1.570796" />
  <link name="$(arg prefix)livox_mid360_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/livox_mid_360.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="livox_mid360_grey">
        <color rgba="0.75 0.75 0.75 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/livox_mid_360.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.029" rpy="0 0 0" />
      <mass value="0.265" />
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00016" />
    </inertial>
  </link>
  <joint name="$(arg prefix)livox_mid360_joint" type="fixed">
    <parent link="$(arg prefix)extras_link" />
    <child link="$(arg prefix)livox_mid360_link" />
    <origin xyz="${livox_mid360_xyz}" rpy="${livox_mid360_rpy}" />
  </joint>
  <link name="$(arg prefix)livox_frame" />
  <joint name="$(arg prefix)livox_frame_joint" type="fixed">
    <parent link="$(arg prefix)livox_mid360_link" />
    <child link="$(arg prefix)livox_frame" />
    <origin xyz="0 0 0.0365" rpy="0 0 0" />
  </joint>

  <!-- tool_head_link (the provisional STEP "Tool head" mesh, a
       placeholder identity-offset guess) has been removed: the real G2
       gripper now attaches at link_eef instead (via add_gripper/
       gripper_version="G2" above), and the two would have overlapped at
       the same frame. meshes/tool_head.stl is no longer referenced. -->

  <xacro:property name="_is_gz_sim" value="${'$(arg ros2_control_plugin)' == 'gz_ros2_control/GazeboSimSystem'}" />
  <xacro:if value="${_is_gz_sim}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg ros2_control_params)</parameters>
        <ros>
          <namespace>/$(arg robot_namespace)</namespace>
        </ros>
      </plugin>
    </gazebo>
    <!-- Registers the world-wide gz::sim::systems::Sensors plugin, needed
         by every rendering sensor in this file (fixed_cam1/2, the two
         USB cameras, the wrist camera, the Livox lidar). Previously
         piggybacked on xarm_device's own add_realsense_d435i="true" call
         (its realsense_gz macro registers the exact same plugin as a
         side effect); now that add_realsense_d435i is "false" (see the
         F/T sensor cylinder/camera_mount_link comment above), it has to
         be registered explicitly instead, exactly matching xarm's own
         realsense.gazebo.xacro plugin block (filename/name/render_engine
         all identical) so nothing else in this file needs to change. -->
    <gazebo>
      <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Two frame-mounted RealSense D435i cameras, per
       RM_Version_1.2_production.step's "Camera_module_for_design"
       cluster. In STEP, "Realsense_Camera_module v2" and
       "Realsense_Camera_module v1(Mirror)(Mirror)" actually sit at the
       exact same point (checked: 0.0mm position difference), differing
       only by a 180deg rotation about one axis; per instruction, given a
       real position offset instead (matching the USB camera pair's own
       genuine left/right spacing in that same cluster, see fixed_cam1_xyz/
       fixed_cam2_xyz below), rather than mounting them coincident. Final
       intended hardware, per instruction: 2x D435i here (this block) +
       1x Orbbec Gemini 2 on the wrist (replacing the arm's own camera
       eventually, software-side only for now, keeping the D435i mesh
       there (camera_mount_link above) until Gemini's own ROS packages
       are wired up).
       Position/rotation derived the same way as extras_link/
       mount_plate_link: STEP-measured offset from the xArm-Mounting
       plate's own native origin, composed with the current (user-tuned)
       mount_plate_xyz/rpy.
       Built from the standard ros-humble-realsense2-description package's
       own sensor_d435i macro (apt package, not xarm_description's
       d435i_urdf like the wrist camera above uses): that vendored one
       hardcodes xarm's own arm-mount stand into the visual mesh
       (d435_with_cam_stand.stl), correct for the wrist where that stand
       is the real hardware, wrong here where these two have their own
       separate STEP-modeled mounting bracket. realsense2_description's
       sensor_d435i uses the bare d435.dae mesh (no mount baked in) and
       is the same macro most ROS RealSense integrations use. It has no
       Gazebo sensor plugin wiring of its own though (purely mechanical
       description), so the fixed_cam_sensor_tags macro below still
       supplies that, same as before; frame naming lines up automatically
       since sensor_d435i's own "name" param becomes the "${name}_"
       prefix on all its frames (depth_frame, color_frame, etc.), and
       fixed_cam_sensor_tags's "prefix" param is applied the same way. -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro" />
  <!-- Height (Z) raised from the individual Realsense_Camera_module STEP
       node's own position (0.06312m) to Camera_module_for_design's own
       bbox-center height (0.3885m in base_link frame; X/Y of that center
       are ~0.142/~0, matching what was already used, so only Z actually
       changes), per instruction: mount at the height of the whole
       cluster's centre, not the individual camera part's own STEP
       position. Y offset (+-0.034949m) reuses the USB camera pair's own
       real measured left/right spacing in this same STEP cluster
       (USB_Camera_module v2 / v1(Mirror), a genuine mounted pair, unlike
       the two Realsense variants which sit exactly coincident in STEP,
       see the comment below) rather than an arbitrary number, per
       instruction that the two cameras need a real position offset
       between them, not just the orientation difference they had before. -->
  <xacro:property name="fixed_cam1_xyz" value="0.250000 0.006 0.378500" />
  <xacro:property name="fixed_cam2_xyz" value="0.032000 -0.006 0.378500" />
  <xacro:property name="fixed_cam1_rpy" value="0 0 0" />
  <xacro:property name="fixed_cam2_rpy" value="0 0 3.14159" />

  <xacro:sensor_d435i parent="$(arg prefix)base_link" name="$(arg prefix)fixed_cam1_camera"
    use_nominal_extrinsics="true" use_mesh="true">
    <origin xyz="${fixed_cam1_xyz}" rpy="${fixed_cam1_rpy}" />
  </xacro:sensor_d435i>

  <xacro:sensor_d435i parent="$(arg prefix)base_link" name="$(arg prefix)fixed_cam2_camera"
    use_nominal_extrinsics="true" use_mesh="true">
    <origin xyz="${fixed_cam2_xyz}" rpy="${fixed_cam2_rpy}" />
  </xacro:sensor_d435i>

  <!-- Two SincereFirst USB camera modules, same "Camera_module_for_design"
       STEP cluster as the two D435i's above (per the fixed_cam1_xyz/
       fixed_cam2_xyz history: their ORIGINAL placeholder position, before
       being moved for visual tuning in Gazebo, was
       "0.142000 (+-0.034949) 0.388500": exactly this cluster's
       bbox-center X/Z composed with the real measured USB-camera-pair Y
       spacing pulled from that same STEP file. That measured spacing is
       reused here verbatim for the actual USB cameras it always described;
       Z is the CURRENT (post-tuning) 0.378500 the D435i's now use, not the
       original 0.388500, per instruction.
       left/right per REP103 (forward=X, left=+Y, up=Z), using fixed_cam1
       (rpy=0, facing +X) as the "front" reference, not tied to
       fixed_cam1/fixed_cam2's own Y-sign convention, which predates this
       and was reassigned during their own tuning.
       No SincereFirst mesh is available in this repo (meshes/ only has
       extras_compressed.stl and xarm_mount_plate.stl): placeholder box
       geometry via usb_camera_macro below, sized for a generic small UVC
       board camera; swap in a real mesh/measured dimensions if/when
       available, same caveat as every other STEP-placeholder geometry in
       this file.
       rpy: facing sideways per instruction, not forward like fixed_cam1
       (an earlier revision defaulted both to rpy="0 0 0"/forward, absent
       any given orientation; corrected here). Yaw +-pi/2 redirects each
       camera's own local +X (forward) axis to world +-Y: REP103 has
       forward=X, left=+Y, so Rz(+pi/2) maps local +X to +Y (left) and
       Rz(-pi/2) maps it to -Y (right); left_camera looks toward the
       robot's left, right_camera toward its right, matching their names
       and fixed_cam1's own rpy=0/+X as the "front" reference direction. -->
  <xacro:property name="left_camera_xyz" value="0.142000 0.059898 0.390000" />
  <xacro:property name="right_camera_xyz" value="0.142000 -0.059898 0.390000" />
  <xacro:property name="left_camera_rpy" value="0 0 1.570796" />
  <xacro:property name="right_camera_rpy" value="0 0 -1.570796" />

  <!-- Generic UVC USB camera: link (placeholder box) + REP103 optical
       frame child, mirroring the physical-frame/optical-frame split
       realsense2_description's sensor_d435 macro uses above (see that
       macro's own depth_joint/depth_optical_joint pair) so this camera's
       image data lines up with the same convention downstream tooling
       (RViz, image_pipeline, etc.) already expects from a ROS camera. -->
  <xacro:macro name="usb_camera_macro" params="name parent *origin">
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${name}_link" />
    </joint>
    <link name="${name}_link">
      <visual>
        <!-- Roll +pi/2 about the link's own local X (its view direction,
             same axis ${name}_optical_joint derives the optical frame
             from): rotates the SHAPE only, not the link/joint/optical
             frame themselves, so the camera's actual mount orientation and
             TF are untouched by this. Box is (X=0.030, Y=0.020, Z=0.030)
             before this roll, so X (view direction, already correct) and Z
             (0.030, "long") swap with Y (0.020, "short"): since each
             camera's own mount joint above is a pure yaw (see
             left_camera_rpy/right_camera_rpy), un-rolled local Y maps to
             world's front-rear (X) axis and local Z to world-up, i.e.
             the SHORT edge would land front-rear and the LONG edge
             vertical. This roll swaps that: long edge -> front-rear axis,
             short edge -> vertical, per instruction. -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <!-- Placeholder dimensions (30x20x30mm): generic small UVC
               board-camera size estimate, not a measured SincereFirst
               spec. -->
          <box size="0.030 0.020 0.030" />
        </geometry>
        <material name="usb_camera_black">
          <color rgba="0.1 0.1 0.1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <box size="0.030 0.020 0.030" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.02" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <joint name="${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${name}_link" />
      <child link="${name}_optical_frame" />
    </joint>
    <link name="${name}_optical_frame" />
  </xacro:macro>

  <xacro:usb_camera_macro name="$(arg prefix)left_camera" parent="$(arg prefix)base_link">
    <origin xyz="${left_camera_xyz}" rpy="${left_camera_rpy}" />
  </xacro:usb_camera_macro>

  <xacro:usb_camera_macro name="$(arg prefix)right_camera" parent="$(arg prefix)base_link">
    <origin xyz="${right_camera_xyz}" rpy="${right_camera_rpy}" />
  </xacro:usb_camera_macro>

  <!-- Sensor tags only (no Sensors-system <plugin> block): realsense_gz
       (realsense.gazebo.xacro) bundles BOTH the per-camera sensor
       declarations AND the world-wide gz::sim::systems::Sensors plugin
       registration in one macro, so calling it here as-is per camera
       would (and, tested, did) re-register that system a 2nd and 3rd
       time on top of the wrist camera's own call inside xarm_device,
       hitting the exact same "Another item already exists with name:
       scene" Ogre2 crash tested_world.world's own duplicate copy caused
       earlier (see that file's comment). One Sensors registration
       (still xarm_device's, for the wrist camera) covers the whole
       simulation; these two only need the sensor tags themselves.
       Reference frame names below (camera_depth_frame, camera_infra1_frame,
       etc.) match realsense2_description's sensor_d435i naming (infra1/
       infra2), NOT xarm_description's own d435i_urdf naming (left_ir/
       right_ir) that this macro's sensor tag content was originally
       copied from, and mismatched once already (silently: gz-sim doesn't
       error on a <gazebo reference> pointing at a link that doesn't
       exist, it just drops that sensor, so fixed_cam1/2's infra1/infra2
       topics were simply missing with nothing in the log to explain why;
       caught by checking `gz topic -l` against the expected topic list
       rather than trusting a clean launch log alone). -->
  <xacro:macro name="fixed_cam_sensor_tags" params="prefix">
    <gazebo reference="${prefix}camera_depth_frame">
      <sensor name="${prefix}cameradepth" type="rgbd_camera">
        <camera name="${prefix}camera">
          <!-- Without this, gz-sim falls back to an auto-generated scoped
               entity path (e.g. 'robot_a/robot_a_base_link/robot_a_fixed_cam1_cameradepth')
               as the frame_id on every message this sensor publishes (image,
               depth image, points, camera_info), not a real TF frame, so
               RViz's PointCloud2/Image displays silently render nothing (no
               transform found), even fully enabled. See camera.sdf's own
               optical_frame_id element ("used in the camera_info message
               header", though it's actually applied to all this sensor's
               messages, not just camera_info; confirmed by echoing
               '.../depth/points's header.frame_id before/after this fix).

               Deliberately pointed at camera_depth_frame (the PHYSICAL,
               non-optical-rotated mount frame), NOT camera_depth_optical_frame
               despite that being the ROS/realsense2_camera-driver convention
               for a depth point cloud: verified empirically (dumped
               .../depth/points, transformed through TF into robot_a_odom,
               compared against tested_world.world's known wall/floor
               geometry) that gz-sim's rgbd_camera sensor (Harmonic, gz-sensors
               8.2.2) actually emits point-cloud XYZ in the SENSOR's own local/
               physical axes (X-forward, Z-up, matching camera_depth_frame),
               NOT the rotated X-right/Y-down/Z-forward optical convention its
               own "optical_frame_id" element name implies. Labeling it
               camera_depth_optical_frame (matching data already in the
               physical convention) made RViz apply that frame's extra
               rotation on top of already-correct data, throwing the cloud
               off (points ending up below the floor, etc). If a future
               gz-sensors version fixes this upstream (starts actually
               rotating point data into the optical frame to match what
               "optical_frame_id" implies), this will need to flip back to
               camera_depth_optical_frame: re-run the same empirical check
               (raw x/y/z stats vs. known nearby world geometry) rather than
               assuming either way. -->
          <optical_frame_id>${prefix}camera_depth_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.100</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}camera/depth</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_color_frame">
      <sensor name="${prefix}cameracolor" type="camera">
        <camera name="${prefix}camera">
          <!-- See the depth sensor's own comment above: same fix, same reason. -->
          <optical_frame_id>${prefix}camera_color_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <camera_info_topic>${prefix}camera/color/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>${prefix}camera/color/image_raw</topic>
        <enable_metrics>true</enable_metrics>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_infra1_frame">
      <sensor name="${prefix}cameraired1" type="camera">
        <camera name="${prefix}camera">
          <!-- See the depth sensor's own comment above: same fix, same reason. -->
          <optical_frame_id>${prefix}camera_infra1_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}camera/infra1/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}camera/infra1/image_raw</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_infra2_frame">
      <sensor name="${prefix}cameraired2" type="camera">
        <camera name="${prefix}camera">
          <!-- See the depth sensor's own comment above: same fix, same reason. -->
          <optical_frame_id>${prefix}camera_infra2_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}camera/infra2/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}camera/infra2/image_raw</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${_is_gz_sim}">
    <xacro:fixed_cam_sensor_tags prefix="$(arg prefix)fixed_cam1_" />
    <xacro:fixed_cam_sensor_tags prefix="$(arg prefix)fixed_cam2_" />
  </xacro:if>

  <!-- Wrist camera (Orbbec Gemini 2, software-side only for now: mesh
       stays the D435i+stand placeholder, see the header comment's own
       "software-side only" note and this session's mesh-recommendation
       discussion: no combined Gemini2+xArm-mount mesh exists, swapping it
       would drop the mount geometry entirely). Same wiring treatment as
       fixed_cam1/fixed_cam2 (correct optical_frame_id, own topics, bridged
       + real driver), applied to the wrist's camera_link/camera_depth_
       frame/camera_color_frame/camera_left_ir_frame/camera_right_ir_frame
       chain (hand-built above, past the F/T sensor cylinder/
       camera_mount_link, same names as xarm_device's own add_realsense_
       d435i="true" used to create): "lens distance similar, thickness
       differs" per instruction, i.e. treat it as a D435i-shaped stand-in
       for now.

       No "xarm's own broken sensor tags running unused alongside"
       tradeoff to make any more (an earlier version of this comment
       described one): add_realsense_d435i is "false" now (see the F/T
       sensor cylinder's own comment above), so xarm_ros2's own realsense.
       gazebo.xacro sensor tags (the ones with the missing-optical_
       frame_id bug) are never created in the first place, not just left
       unused: this macro's own sensor set below is the only one. Still
       not editing realsense.gazebo.xacro directly either way: xarm_ros2
       is a git submodule, this repo's own established practice already
       avoids touching it (see xarm_device's add_gripper comment above).
       No new Sensors-system plugin registration needed here: it's
       registered explicitly now (see the _is_gz_sim gz_ros2_control
       plugin block above), not piggybacked on xarm's own realsense_gz
       call any more. -->
  <!-- Real Orbbec Gemini 2 extrinsics (depth/color/left_ir/right_ir
       spacing), NOT xarm_description's borrowed D435i ones: per
       instruction, mesh stays the D435i+stand placeholder (camera_link,
       parented to camera_mount_link via the hand-built camera_link_joint
       above) but the actual sensor-to-sensor geometry these frames
       encode should reflect the real hardware. Pulled directly from
       ros-humble-orbbec-description's gemini_2.urdf.xacro (installed on
       this machine), which ships real measured joint origins, not
       placeholders; composed onto camera_link directly rather than
       copying that file's own parent chain verbatim: its camera_color_
       joint/camera_right_ir_joint parent from camera_depth_frame, but
       that frame is itself xyz="0 0 0" rpy="0 0 0" relative to
       camera_link (see its own camera_depth_joint), i.e. an identity
       transform, so composing through it or going straight to
       camera_link gives identical numbers either way; straight to
       camera_link is simpler and avoids needing a whole separate
       depth_frame-as-parent link just to prove that to a future reader.
       New, distinctly-named frames (gemini_*), NOT overriding
       camera_depth_frame/camera_color_frame/camera_left_ir_frame/
       camera_right_ir_frame in place: kept purely for backward
       compatibility with anything already expecting those exact names
       (wrist_camera_sensor_tags below, RViz, ranger_xarm6.launch.py),
       not a submodule constraint any more (those frames are hand-built
       above now, so renaming them outright was an option this time). -->
  <xacro:macro name="orbbec_gemini2_extrinsics" params="prefix">
    <xacro:macro name="_gemini_frame" params="name xyz">
      <joint name="${prefix}gemini_${name}_joint" type="fixed">
        <origin xyz="${xyz}" rpy="0 0 0" />
        <parent link="${prefix}camera_link" />
        <child link="${prefix}gemini_${name}_frame" />
      </joint>
      <link name="${prefix}gemini_${name}_frame" />
      <joint name="${prefix}gemini_${name}_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
        <parent link="${prefix}gemini_${name}_frame" />
        <child link="${prefix}gemini_${name}_optical_frame" />
      </joint>
      <link name="${prefix}gemini_${name}_optical_frame" />
    </xacro:macro>
    <!-- depth and left_ir are coincident (0,0,0) in Orbbec's own file too,
         same "depth derives from one IR sensor" convention D435i uses. -->
    <xacro:_gemini_frame name="depth" xyz="0 0 0" />
    <xacro:_gemini_frame name="left_ir" xyz="0 0 0" />
    <xacro:_gemini_frame name="right_ir" xyz="0 -0.05000000074505806 0" />
    <xacro:_gemini_frame name="color" xyz="0.0019099999917671084 -0.01400499977171421 4.999999873689376e-06" />
  </xacro:macro>

  <xacro:if value="${_is_gz_sim}">
    <xacro:orbbec_gemini2_extrinsics prefix="$(arg prefix)" />
  </xacro:if>

  <xacro:macro name="wrist_camera_sensor_tags" params="prefix">
    <gazebo reference="${prefix}gemini_depth_frame">
      <sensor name="${prefix}wristcameradepth" type="rgbd_camera">
        <camera name="${prefix}wristcamera">
          <!-- Physical, not optical, frame: same gz-sim rgbd_camera
               point-cloud convention quirk as fixed_cam_sensor_tags' own
               depth sensor above: see that comment for the full
               empirical verification. Same gz-sensors version, same
               sensor type, so the same fix applies here without needing
               to re-derive it, though this specific sensor's point cloud
               hasn't been separately re-verified against known world
               geometry the way fixed_cam1's was. -->
          <optical_frame_id>${prefix}gemini_depth_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.100</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}wrist_camera/depth</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}gemini_color_frame">
      <sensor name="${prefix}wristcameracolor" type="camera">
        <camera name="${prefix}wristcamera">
          <optical_frame_id>${prefix}gemini_color_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <camera_info_topic>${prefix}wrist_camera/color/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>${prefix}wrist_camera/color/image_raw</topic>
        <enable_metrics>true</enable_metrics>
      </sensor>
    </gazebo>
    <!-- Reference links are the new gemini_left_ir_frame/gemini_right_ir_frame
         (this macro's own orbbec_gemini2_extrinsics, above; left/right
         naming kept consistent with xarm_description's own d435i_urdf
         convention it replaces), but topics/optical frames below still say
         "infra1"/"infra2": matching xarm's own realsense_gz macro's
         identical left=infra1/right=infra2 convention (and
         fixed_cam_sensor_tags'), so downstream consumers see the same
         topic shape regardless of which camera it's from. -->
    <gazebo reference="${prefix}gemini_left_ir_frame">
      <sensor name="${prefix}wristcameraired1" type="camera">
        <camera name="${prefix}wristcamera">
          <optical_frame_id>${prefix}gemini_left_ir_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}wrist_camera/infra1/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}wrist_camera/infra1/image_raw</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}gemini_right_ir_frame">
      <sensor name="${prefix}wristcameraired2" type="camera">
        <camera name="${prefix}wristcamera">
          <optical_frame_id>${prefix}gemini_right_ir_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}wrist_camera/infra2/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}wrist_camera/infra2/image_raw</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${_is_gz_sim}">
    <xacro:wrist_camera_sensor_tags prefix="$(arg prefix)" />
  </xacro:if>

  <!-- Plain single-image gz sensor for one usb_camera_macro instance
       (left_camera/right_camera): same structure as fixed_cam_sensor_tags'
       own color block above, just parameterized by 'name' instead of
       hardcoding "camera" (usb_camera_macro's links are named
       "${name}_link"/"${name}_optical_frame" directly, not
       "${prefix}camera_..." like sensor_d435i's convention). Placeholder
       resolution/FOV (1280x720, 1.57rad) matching the D435i color stream
       above pending real SincereFirst datasheet values. -->
  <xacro:macro name="usb_camera_sensor_tags" params="name">
    <gazebo reference="${name}_link">
      <sensor name="${name}sensor" type="camera">
        <camera name="${name}">
          <optical_frame_id>${name}_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <camera_info_topic>${name}/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>${name}/image_raw</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${_is_gz_sim}">
    <xacro:usb_camera_sensor_tags name="$(arg prefix)left_camera" />
    <xacro:usb_camera_sensor_tags name="$(arg prefix)right_camera" />
  </xacro:if>

  <!-- Sim-only depth-test target: a tall, slim, world-upright cylinder,
       0.5m straight out from fixed_cam1's own lens, for visually/
       numerically verifying that camera's point cloud alignment (an
       asymmetric-enough, unambiguous target: unlike tested_world.world's
       flat, left-right-symmetric wall, which can't reveal certain bugs,
       e.g. a mirror flip, since it looks the same either way).
       Parented directly to fixed_cam1_camera_link (NOT base_link) so "0.5m
       in front of the camera" stays literally true regardless of where
       fixed_cam1_xyz/rpy above end up being tuned to. xyz="0.5 0 0" is
       exactly the "camera forward" axis in that link's own physical
       (non-optical) convention: the same X-forward convention this
       package's point-cloud optical_frame_id fix (fixed_cam_sensor_tags'
       depth sensor, above) is keyed to, so a correctly-calibrated point
       cloud should show this cylinder's surface at very close to x=0.5m in
       the raw (sensor-local) depth data.
       rpy="0 0 0" (no counter-rotation) relies on fixed_cam1_xyz/rpy only
       ever applying pure YAW (0 or pi so far, see fixed_cam1_rpy/
       fixed_cam2_rpy above): yaw alone keeps a cylinder's own Z axis
       aligned with world Z (upright) regardless of heading, so this only
       needs revisiting if a fixed camera ever gets pitch/roll added.
       Visual only (no <collision>): a depth/rgbd camera sensor renders
       from the visual mesh, not physics collision, so collision geometry
       would add self-collision computation for zero benefit here. Debug
       aid only: gated on _is_gz_sim so it never appears on the real
       robot's model. -->
  <xacro:if value="${_is_gz_sim}">
    <xacro:property name="cam1_test_target_radius" value="0.025" />
    <xacro:property name="cam1_test_target_height" value="1.0" />
    <link name="$(arg prefix)fixed_cam1_test_target_link">
      <visual>
        <geometry>
          <cylinder radius="${cam1_test_target_radius}" length="${cam1_test_target_height}" />
        </geometry>
        <material name="test_target_orange">
          <color rgba="1.0 0.5 0.0 1" />
        </material>
      </visual>
      <inertial>
        <mass value="0.05" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>
    <joint name="$(arg prefix)fixed_cam1_test_target_joint" type="fixed">
      <parent link="$(arg prefix)fixed_cam1_camera_link" />
      <child link="$(arg prefix)fixed_cam1_test_target_link" />
      <origin xyz="0.5 0 0" rpy="0 0 0" />
    </joint>
  </xacro:if>

  <!-- State-only ros2_control interface for the base's 4 steering + 4 wheel
       joints (see ranger_mini_v3.xacro's own header comment: they're left
       passive, no command interface / drive plugin; driving the base is
       still separate follow-up work, unchanged by this). Without any
       ros2_control interface, nothing ever published these joints' state,
       so robot_state_publisher had no value for them and couldn't compute
       their TF: RViz's RobotModel display then has no transform for the
       wheel/steering links and hides them entirely (not just "not moving",
       genuinely absent). Declaring them here with state_interface only (no
       command_interface, no new controller) lets gz_ros2_control's
       GazeboSimSystem report their actual simulated pose, picked up by
       the same joint_state_broadcaster the arm already uses (it publishes
       every joint from every claimed hardware interface by default, see
       config/ros2_controllers.yaml: no 'joints' list there means "all of
       them"), so the wheels/steering render (static, since nothing drives
       them yet) instead of disappearing. Real hardware isn't affected:
       this whole block is gz-sim-only (_is_gz_sim), same as the plugin
       block above.
  -->
  <xacro:if value="${_is_gz_sim}">
    <ros2_control name="RangerBaseState" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:macro name="_passive_wheel_joint" params="name">
        <joint name="$(arg prefix)${name}">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:_passive_wheel_joint name="fl_steering_joint"/>
      <xacro:_passive_wheel_joint name="fl_wheel"/>
      <xacro:_passive_wheel_joint name="fr_steering_joint"/>
      <xacro:_passive_wheel_joint name="fr_wheel"/>
      <xacro:_passive_wheel_joint name="rl_steering_joint"/>
      <xacro:_passive_wheel_joint name="rl_wheel"/>
      <xacro:_passive_wheel_joint name="rr_steering_joint"/>
      <xacro:_passive_wheel_joint name="rr_wheel"/>
      <!-- HiPNUC IMU state interface (see hipnuc_imu_sensor's <gazebo>
           block, below): purely to stop gz_ros2_control's GazeboSimSystem
           from logging "IMU sensor '...' not found in hardware_info,
           skipping." on every load: it scans every gz IMU sensor in the
           model and checks each one against a <ros2_control> hardware_info
           sensor list like this one (see gz_system.cpp's registerSensors),
           independent of the ros_gz_bridge topic pipeline actually used
           for the published /hipnuc_imu/data data (its frame_id comes
           from hipnuc_imu_sensor's own <gz_frame_id> tag, below).
           Nothing currently reads this ros2_control state interface (no
           IMUSensorBroadcaster in config/ros2_controllers.yaml); it's
           registered here only so the interface EXISTS, ready if a
           consumer needs it later. Sensor name must match the SDF
           <sensor name="..."> exactly (gz_ros2_control matches by gz
           entity name, not by frame/topic), and the state_interface names
           must be exactly gz_system.cpp's own fixed 10-entry
           interface_name_map. -->
      <sensor name="$(arg prefix)hipnuc_imu_sensor">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>
  </xacro:if>

  <!-- F/T SENSOR (Gazebo simulation only): simulated physics force/torque
       measurement at joint6. This is the sim-side sensor plugin, separate
       from model1300="true" above (which swaps in the F/T-sensor-equipped
       tool-flange MESH); the physical accessory's presence, previously
       flagged here as unconfirmed, is now confirmed by
       RM_Version_1.2_production.step's arm node itself being named
       "xArm6(XI1300)_02022023". On actual hardware this comes from that
       accessory via ranger_xarm6.launch.py's sim:=false path (remaps
       'uf_ftsensor_ext_states'). Mirrors the same gz-sim force_torque
       sensor + flat 'force_torque' topic convention robotnik_description
       uses at UR5e's wrist_3 for Theron/Kairos (see rbtheron_plus.urdf.xacro),
       so wbc.py's force_torque_callback needs no changes either way. -->
  <xacro:if value="${_is_gz_sim}">
    <gazebo reference="$(arg prefix)joint6">
      <sensor name="force_torque_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>500</update_rate>
        <visualize>true</visualize>
        <topic>force_torque</topic>
        <force_torque>
          <frame>sensor</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- HiPNUC HI14R3-232-000 IMU (gz-sim only): attached to
       hipnuc_imu_data_frame, NOT hipnuc_imu_link, since that data frame is
       the one whose axes actually match what the sensor reports (see that
       frame's own comment, above, for the RFU-vs-FLU derivation). Real
       hardware: the official HiPNUC ROS2 driver (hipnuc/products,
       ros/ros2/hipnuc_imu) publishes the same message type
       (sensor_msgs/Imu) on 'imu/data' directly from the physical device
       over RS-232, not wired here yet; that needs vendoring the driver
       repo first (a real git-submodule-sized decision, held pending
       confirmation rather than done unprompted this same session).
       Noise stddev values are the real R3-grade datasheet specs (Table 9
       gyroscope / Table 11 accelerometer noise density for HI14R2/HI14R3,
       identical for both), unit-converted for gz-sim's own SI expectations:
       gyro 0.008 deg/s/sqrt(Hz) * (pi/180) = 0.0001396 rad/s/sqrt(Hz);
       accel 0.09 mg/sqrt(Hz) * 9.80665e-3 = 0.0008826 m/s^2/sqrt(Hz).
       update_rate 100Hz matches the datasheet's own "Nom" UART output
       frame rate (Table 8; max is 1000Hz, configurable on the real
       device). No Sensors-system plugin registration needed here: unlike
       camera-type sensors (rendered, need gz::sim::systems::Sensors,
       already registered once via the wrist camera above), an IMU sensor
       is computed directly from the link's own physics state and doesn't
       need a render-engine-backed system. -->
  <xacro:if value="${_is_gz_sim}">
    <gazebo reference="$(arg prefix)hipnuc_imu_data_frame">
      <sensor name="$(arg prefix)hipnuc_imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>$(arg prefix)hipnuc_imu/data</topic>
        <gz_frame_id>$(arg prefix)hipnuc_imu_data_frame</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0001396</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0001396</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0001396</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008826</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008826</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008826</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Livox Mid-360 (gz-sim only): attached to livox_frame (the real
       sensor-origin child frame, not the mount link: see that frame's
       own comment above). gz-sim's gpu_lidar sensor type has no native
       point-cloud output (checked: libgz-sensors8-gpu-lidar.so has zero
       references to "points" anywhere, unlike libgz-sensors8-rgbd_camera
       .so, which does: rgbd_camera is a special combined sensor class
       purpose-built to also emit PointCloudPacked, gpu_lidar never was).
       It only ever publishes a flat gz.msgs.LaserScan on <topic>.
       ros_gz_bridge's own sensor_msgs/LaserScan converter was tried
       first and turned out to silently truncate a multi-vertical-channel
       scan down to just its first (horizontal-only) row: verified live,
       a 1200x32 sensor bridged to ROS came through with exactly 1200
       ranges, not 38400 (no "vertical" string anywhere in
       libros_gz_bridge_lib.so hinted at this beforehand, but didn't
       prove it either way). gz_lidar_to_pointcloud.py (new,
       ranger_xarm6.launch.py) subscribes to the raw gz topic directly
       via gz-transport instead (bypassing ros_gz_bridge for this one
       sensor entirely), reading gz.msgs.LaserScan's own proto fields
       (vertical_count, vertical_angle_min/max/step) straight from each
       message rather than duplicating horizontal_samples/vertical_
       samples/angle values as separate, easy-to-drift-out-of-sync
       launch arguments.
       <gz_frame_id> works the same way it does for hipnuc_imu_sensor
       above (a generic gz-sensors8 Sensor-base-class override, not
       lidar-specific): confirmed via the same static check (Lidar's own
       compiled library calls Sensor::FrameId(), same as Imu's), verified
       live once built.
       No new Sensors-system <plugin> registration needed: gpu_lidar is a
       rendering sensor (like the cameras), and gz::sim::systems::Sensors
       is already registered once via the wrist camera above.
       Range 0.2-40.0m and update_rate 10Hz are Weston Robot's own real
       operational values for this exact sensor (github.com/westonrobot/
       wr_devkit_mapping's params.yaml: "lidarMinRange: 0.2 ... 0.2 for
       livox", "lidarMaxRange: 40.0 ... 40.0 for livox", livox_ros_
       driver2's own launch file's publish_freq=10.0 default), not the
       datasheet's own more optimistic max-range spec. Vertical FOV
       (-7 to 52deg) is the real Mid-360 datasheet spec (Weston Robot's
       own materials don't give an angular FOV number to prefer instead).
       horizontal_samples/vertical_samples (1200/32) are Robotnik's own
       proven gz-sim gpu_lidar grid-approximation resolution: gpu_lidar
       fundamentally cannot reproduce Livox's real non-repetitive
       scanning pattern (a uniform rectangular sample grid is the only
       shape gpu_lidar can render), so there's no "real" number to derive
       instead; reusing an already-tuned value beats guessing a new one.
       Noise stddev 0.03 is likewise Robotnik's own tuned value, no
       better real number available for this simulation approximation. -->
  <xacro:if value="${_is_gz_sim}">
    <gazebo reference="$(arg prefix)livox_frame">
      <sensor name="$(arg prefix)livox_mid360_sensor" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>$(arg prefix)livox/lidar_raw</topic>
        <gz_frame_id>$(arg prefix)livox_frame</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1200</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>${radians(-7)}</min_angle>
              <max_angle>${radians(52)}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>40.0</max>
            <resolution>1</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.03</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>
