<?xml version="1.0" encoding="utf-8"?>
<!--
  Ranger Mini 3.0 + xArm6 mobile manipulator description, used for both
  Gazebo Harmonic simulation and real hardware (see ranger_xarm6.launch.py,
  'sim' argument).

  Composes ranger_mini_v3_description (base) and xarm_description (arm),
  following the same "base macro + arm macro + fixed mount origin" pattern
  already used in this workspace for rbtheron_plus.urdf.xacro (see
  src/robotnik/robotnik_description/robots/rbtheron/rbtheron_plus.urdf.xacro).

  The arm's ros2_control interface ('arm_velocity_controller', see
  config/ros2_controllers.yaml) matches what wbcc_controller/wbc.py expects
  for Theron/Kairos's UR5e arm, so wbc.py needs no changes to drive this
  arm. The mobile base still has no ros2_control command interface for its
  wheels (only the state-only block below, for RobotModel/TF); real
  hardware drive is separate follow-up work
  (ranger_bringup/westonrobot_ranger_ros2, vendored, untested). Simulation
  driving IS wired up, just not through this URDF: see
  launch/ranger_xarm6.launch.py's base_pose_publisher.py, a kinematic
  (not physics-based) stand-in that integrates wbc.py's cmd_vel directly
  and teleports the Gazebo entity, bypassing wheel-level control entirely.
-->
<robot name="ranger_xarm6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="" />
  <!-- Undecorated robot_id (no trailing underscore), used only to namespace
       the Gazebo gz_ros2_control plugin block below; kept separate from
       'prefix' (which DOES have the trailing underscore baked in for link/
       joint names) because the plugin's <ros><namespace> tag wants a plain
       namespace segment, not a name-prefix string. -->
  <xacro:arg name="robot_namespace" default="" />
  <xacro:arg name="ros2_control_params" default="" />
  <!-- sim (default): gz_ros2_control/GazeboSimSystem. xarm_device_macro's
       own built-in gazebo-plugin support (load_gazebo_plugin) has no
       namespace option, so it's always left off here and we emit our own
       <gazebo><plugin> block below instead (with a <ros><namespace> tag),
       matching the pattern robotnik_description uses for Theron/Kairos:
       see src/robotnik/robotnik_description/simulators/gazebo_ignition/
       rbtheron/rbtheron_control.urdf.xacro.
       real hardware: ros2_control_plugin:=uf_robot_hardware/UFRobotSystemHardware,
       robot_ip:=<arm IP>; no Gazebo plugin involved either way.
       See ranger_xarm6.launch.py, sim:=false path. -->
  <xacro:arg name="ros2_control_plugin" default="gz_ros2_control/GazeboSimSystem" />
  <xacro:arg name="robot_ip" default="" />
  <!-- Diagnostic toggle for fixed_cam1/fixed_cam2 (the two frame-mounted
       D435i's), default false per instruction: swaps sensor_d435i's own
       'use_mesh' param, so 'false' drops the DAE visual/collision mesh
       (camera/realsense/visual+collision d435.dae, via
       realsense2_description) down to its own small box fallback (see
       that macro's own use_mesh:=false branch: a
       d435_cam_depth x d435_cam_width x d435_cam_height box, ~0.025x0.09x0.025m,
       roughly the actual camera body's footprint): lets you compare the
       point cloud with the full mesh vs. the plain box to check whether
       the mesh itself (not just the camera's mount/orientation, already
       checked separately this session) is what's obstructing/producing
       wrong-looking points. Does NOT affect fixed_cam1/fixed_cam2's
       frames, TF, or sensor topics at all: purely the visual/collision
       geometry sensor_d435i itself renders. Flip back to true once done:
       `ros2 launch ranger_xarm6_description ranger_xarm6.launch.py
       fixed_cam_use_mesh:=true`. -->
  <xacro:arg name="fixed_cam_use_mesh" default="false" />

  <!-- ====================================================================
       FT: base -> arm mount transform, corrected from Gazebo visual
       inspection after the STEP-derived heights kept turning out wrong.
       x=-0.2185 (from the mounting-plate geometry in
       RM_Version_1.2_production.step) checked out visually. z, however,
       was wrong at 0.25368 (mount plate height relative to the STEP CAD's
       "Ranger Mini 3.0" node origin), that STEP node's own origin isn't
       the same reference point as this package's base_link (base_link
       sits near the top of the chassis per ranger_mini_v3.xacro's
       collision box / visual mesh; the STEP node's origin is lower, deeper
       inside the chassis body), so the two aren't directly comparable
       without correcting for that offset. z set to 0.024 (24mm) per direct
       visual correction in Gazebo (arm was floating too high). Yaw set to
       180 degrees, also per visual correction. Still not a hardware
       measurement, treat as provisional until the real mount is
       physically measured or the arm's true orientation is confirmed
       against the ARTC handover note.
       Kept numerically in sync with arm_base_joint's origin in
       urdf/ranger_xarm6.urdf.
       ==================================================================== -->
  <xacro:property name="arm_mount_xyz" value="-0.218500 0.000000 0.024000" />
  <xacro:property name="arm_mount_rpy" value="0 0 3.141593" />

  <!-- ====================================================================
       FT: base_link -> xarm mount-plate visual (meshes/xarm_mount_plate.stl),
       derived from RM_Version_1.2_production.step. Unlike arm_mount_xyz/rpy
       above, this one is NOT independently visually corrected: it's
       arm_mount_xyz/rpy (base_link -> link_base, already trusted/tuned)
       composed with the STEP-measured link_base -> plate transform, i.e.
       "wherever the trusted arm mount is, the plate sits at this fixed
       offset from it" per CAD. That composition sidesteps the ranger's own
       STEP origin entirely (per-repo note: this STEP's Ranger Mini node is
       simplified and its origin doesn't line up with ranger_mini_v3.xacro's
       base_link), since both the plate and the arm hang off the same
       "Version_1.2_production_locked" assembly root and are properly
       mated to each other there. Purely a visual/collision addition (the
       xArm-Mounting plate on Ranger Mini node in STEP); it carries no new
       joint, base_link already accounts for the arm sitting at the height
       arm_mount_xyz/rpy implies.
       ==================================================================== -->
  <xacro:property name="mount_plate_xyz" value="-0.218500 0 0.02000" />
  <xacro:property name="mount_plate_rpy" value="0 0 -1.570796" />

  <!-- Base: Ranger Mini 3.0 -->
  <xacro:include filename="$(find ranger_mini_v3_description)/urdf/ranger_mini_v3.xacro" />
  <xacro:ranger_mini_v3 prefix="$(arg prefix)" />

  <!-- Arm: xArm6, mounted on the base via the placeholder FT above.
       model1300="true": this unit is the F/T-sensor-equipped "XI1300"
       variant (confirmed by RM_Version_1.2_production.step's own arm
       node name, "xArm6(XI1300)_02022023"), swaps link6's mesh from
       the plain xarm_description default to end_tool/visual/collision
       end_tool_1300.stl, xarm_description's actual model of the
       F/T-sensor-equipped tool flange (see xarm6.urdf.xacro's
       model_num >= 1300 branch), a single combined mesh, no separate
       F/T sensor accessory mesh exists to add on top of it.
       add_realsense_d435i="true": adds the wrist-mounted RealSense
       D435i (own link_eef body with the d435_with_cam_stand mesh,
       camera_depth/color/left_ir/right_ir frames, and, since
       ros2_control_plugin is gz_ros2_control/GazeboSimSystem here,
       the Harmonic-native realsense_gz sensor plugin), i.e. NOT
       use_gazebo_camera/camera_gazebo, a different, unrelated legacy
       fixture (hardcoded on link_base, Gazebo-Classic-only
       libgazebo_ros_camera.so plugin, incompatible with Harmonic).
       Intended physical stack, per instruction: link6 (F/T sensor,
       built into the end_tool_1300 mesh above) -> camera -> gripper,
       in series. add_gripper is left false here on purpose: the G2
       gripper is instead attached explicitly below, offset past the
       camera+stand's own 30mm depth, because xarm_device_macro.xacro
       hardcodes the gripper's attach_xyz/attach_rpy at "0 0 0" with no
       parameter to override it from out here, which would otherwise
       plant the gripper's base mesh 30mm deep inside the camera stand
       (both attaching directly to link_eef, which IS the camera+stand
       body when add_realsense_d435i is on). Calling xarm_gripper_macro
       ourselves avoids touching the vendored xarm_ros2 submodule for
       this. -->
  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro" />
  <xacro:xarm_device
    prefix="$(arg prefix)"
    dof="6"
    robot_type="xarm"
    hw_ns="xarm"
    attach_to="$(arg prefix)base_link"
    attach_xyz="${arm_mount_xyz}"
    attach_rpy="${arm_mount_rpy}"
    create_attach_link="false"
    ros2_control_plugin="$(arg ros2_control_plugin)"
    ros2_control_params="$(arg ros2_control_params)"
    robot_ip="$(arg robot_ip)"
    load_gazebo_plugin="false"
    model1300="true"
    add_realsense_d435i="true"
    add_gripper="false"
  />

  <!-- G2 gripper, attached explicitly here (not via xarm_device's own
       add_gripper) so it can be offset past the camera+stand's 30mm
       depth instead of overlapping it at link_eef; see the comment on
       the xarm_device call above. Same macro xarm_device would have
       called internally; ros2_control_plugin/dof match what was passed
       there, hard_interface left at its default (PositionJointInterface,
       matching effort_control=false/velocity_control=false, xarm_device's
       own defaults, which the arm above also used). common.link.xacro
       needs its own explicit include here: xarm_device_macro.xacro
       includes it too, but that's nested inside xarm_device's own macro
       body, so the macro definitions it provides (common_link_visual
       etc., which xarm_gripper_urdf.xacro needs) don't leak out to this
       scope, unlike properties declared scope="parent". -->
  <xacro:include filename="$(find xarm_description)/urdf/common/common.link.xacro" />
  <xacro:include filename="$(find xarm_description)/urdf/gripper/xarm_gripper_macro.xacro" />
  <xacro:xarm_gripper_macro
    prefix="$(arg prefix)"
    attach_to="$(arg prefix)link_eef"
    attach_xyz="0 0 0.003"
    attach_rpy="0 0 0"
    ros2_control_plugin="$(arg ros2_control_plugin)"
    dof="6"
    gripper_version="G2"
  />

  <!-- Arm-to-base mounting plate (visual/collision only, no new joint):
       the physical bracket the xArm6 bolts to on top of the Ranger, per
       RM_Version_1.2_production.step's "xArm-Mounting plate on Ranger
       Mini" node. Missing from Gazebo until now; the fixed transform above
       (arm_mount_xyz/rpy) already accounted for its effect on the arm's
       pose, this just makes it visible/collidable too. -->
  <link name="$(arg prefix)mount_plate_link">
    <visual>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/xarm_mount_plate.stl" />
      </geometry>
      <material name="mount_plate_grey">
        <color rgba="0.6 0.6 0.6 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/xarm_mount_plate.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
  </link>
  <joint name="$(arg prefix)mount_plate_joint" type="fixed">
    <parent link="$(arg prefix)base_link" />
    <child link="$(arg prefix)mount_plate_link" />
    <origin xyz="${mount_plate_xyz}" rpy="${mount_plate_rpy}" />
  </joint>

  <!-- Camera rig + leftover shapes from RM_Version_1.2_production.step,
       under its root assembly ("Version_1.2_production_locked"): the
       "Camera_module_for_design" subtree (USB_Camera_module /
       Realsense_Camera_module x2 + Top_plate_blank + Component104,
       previously found floating unmated near the STEP origin) and the
       root-level anonymous "leftover free shape" bucket FreeCAD's STEP
       importer collects there (labelled COMPOUND004 in this FreeCAD
       import; a different CAD tool may number/name it differently, e.g.
       "Compound031", same node). All individual fastener/screw PRODUCT
       instances (10 of them, at the assembly root) are deliberately
       excluded, per instruction. Merged into one mesh; the actual root
       cause of Top_plate_blank looking disconnected from its mounting
       bracket in Gazebo (a "floating panel") turned out to be FreeCAD's
       own STEP-to-mesh tessellation specifically, not decimation and not
       a seam/vertex-welding problem: confirmed by tessellating Compound031
       alone (no merging, no decimation, full fidelity) through two other
       OpenCASCADE-based pipelines (CadQuery/OCP and raw pythonocc-core)
       and comparing all three; only FreeCAD's output showed the gap
       (pythonocc-core's run even logged it outright: "8 faces have been
       skipped due to null triangulation"). So this mesh is now generated
       via CadQuery instead: FreeCAD is still used to navigate the STEP
       assembly tree and select/isolate this bundle's shapes by label (a
       different problem, unaffected by this), re-exported losslessly as
       a standalone intermediate STEP (pure BREP, no tessellation), then
       CadQuery reads THAT and does the actual meshing (0.05mm linear /
       0.3 angular tolerance) and STL export: 122.5k faces, 5.8MB. (mm ->
       m unit conversion and the bbox-center recentering below were done
       as a pure vertex-scale/translate on the already-tessellated
       triangle data, not via CadQuery's own Shape.scale(), because
       combining scale() with export bloated the file to 150+MB:
       non-uniform-looking OCCT transforms can force simple analytic
       surfaces (cylinders etc.) into more general BSpline
       representations before meshing, producing far more triangles for
       the same nominal tolerance.) Positioned the same way as
       mount_plate_xyz/rpy above: this bundle's merged bounding-box
       center, taken as a world-axis-aligned point (no rotation applied
       beyond that), expressed relative to the xArm-Mounting plate's own
       native STEP origin and then composed with mount_plate_xyz/rpy
       (itself trusted/tuned now), verified by reconstructing the merged
       mesh's points through this exact transform and overlaying them back
       onto the original STEP geometry (matched), and confirmed the
       fastener exclusion doesn't change this position (they sat within
       the bounding box already). That's a placement, not a mounting
       relationship, though: this bundle was NOT assembly-mated to
       anything in the CAD (it sat parked near the STEP file's origin,
       across multiple unresolved design variants: v1/v2/Mirror, per
       the "for_design" folder it came from), so treat this link's
       position as "reproduces where the STEP file happened to leave it,
       converted into base_link's frame" rather than a measured or
       verified real-world mounting location. -->
  <xacro:property name="extras_xyz" value="0.1435 0 0.2095" />
  <xacro:property name="extras_rpy" value="0 0 -1.570796" />
  <link name="$(arg prefix)extras_link">
    <visual>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/extras_compressed.stl" />
      </geometry>
      <material name="extras_grey">
        <color rgba="0.5 0.5 0.55 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ranger_xarm6_description/meshes/extras_compressed.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
  <joint name="$(arg prefix)extras_joint" type="fixed">
    <parent link="$(arg prefix)base_link" />
    <child link="$(arg prefix)extras_link" />
    <origin xyz="${extras_xyz}" rpy="${extras_rpy}" />
  </joint>

  <!-- tool_head_link (the provisional STEP "Tool head" mesh, a
       placeholder identity-offset guess) has been removed: the real G2
       gripper now attaches at link_eef instead (via add_gripper/
       gripper_version="G2" above), and the two would have overlapped at
       the same frame. meshes/tool_head.stl is no longer referenced. -->

  <xacro:property name="_is_gz_sim" value="${'$(arg ros2_control_plugin)' == 'gz_ros2_control/GazeboSimSystem'}" />
  <xacro:if value="${_is_gz_sim}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg ros2_control_params)</parameters>
        <ros>
          <namespace>/$(arg robot_namespace)</namespace>
        </ros>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Two frame-mounted RealSense D435i cameras, per
       RM_Version_1.2_production.step's "Camera_module_for_design"
       cluster. In STEP, "Realsense_Camera_module v2" and
       "Realsense_Camera_module v1(Mirror)(Mirror)" actually sit at the
       exact same point (checked: 0.0mm position difference), differing
       only by a 180deg rotation about one axis; per instruction, given a
       real position offset instead (matching the USB camera pair's own
       genuine left/right spacing in that same cluster, see fixed_cam1_xyz/
       fixed_cam2_xyz below), rather than mounting them coincident. Final
       intended hardware, per instruction: 2x D435i here (this block) +
       1x Orbbec Gemini 2 on the wrist (replacing the arm's own camera
       eventually, software-side only for now, keeping the D435i mesh
       there via add_realsense_d435i above until Gemini's own ROS
       packages are wired up).
       Position/rotation derived the same way as extras_link/
       mount_plate_link: STEP-measured offset from the xArm-Mounting
       plate's own native origin, composed with the current (user-tuned)
       mount_plate_xyz/rpy.
       Built from the standard ros-humble-realsense2-description package's
       own sensor_d435i macro (apt package, not xarm_description's
       d435i_urdf like the wrist camera above uses): that vendored one
       hardcodes xarm's own arm-mount stand into the visual mesh
       (d435_with_cam_stand.stl), correct for the wrist where that stand
       is the real hardware, wrong here where these two have their own
       separate STEP-modeled mounting bracket. realsense2_description's
       sensor_d435i uses the bare d435.dae mesh (no mount baked in) and
       is the same macro most ROS RealSense integrations use. It has no
       Gazebo sensor plugin wiring of its own though (purely mechanical
       description), so the fixed_cam_sensor_tags macro below still
       supplies that, same as before; frame naming lines up automatically
       since sensor_d435i's own "name" param becomes the "${name}_"
       prefix on all its frames (depth_frame, color_frame, etc.), and
       fixed_cam_sensor_tags's "prefix" param is applied the same way. -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro" />
  <!-- Height (Z) raised from the individual Realsense_Camera_module STEP
       node's own position (0.06312m) to Camera_module_for_design's own
       bbox-center height (0.3885m in base_link frame; X/Y of that center
       are ~0.142/~0, matching what was already used, so only Z actually
       changes), per instruction: mount at the height of the whole
       cluster's centre, not the individual camera part's own STEP
       position. Y offset (+-0.034949m) reuses the USB camera pair's own
       real measured left/right spacing in this same STEP cluster
       (USB_Camera_module v2 / v1(Mirror), a genuine mounted pair, unlike
       the two Realsense variants which sit exactly coincident in STEP,
       see the comment below) rather than an arbitrary number, per
       instruction that the two cameras need a real position offset
       between them, not just the orientation difference they had before. -->
  <xacro:property name="fixed_cam1_xyz" value="0.250000 0.006 0.378500" />
  <xacro:property name="fixed_cam2_xyz" value="0.032000 -0.006 0.378500" />
  <xacro:property name="fixed_cam1_rpy" value="0 0 0" />
  <xacro:property name="fixed_cam2_rpy" value="0 0 3.14159" />

  <xacro:sensor_d435i parent="$(arg prefix)base_link" name="$(arg prefix)fixed_cam1_camera"
    use_nominal_extrinsics="true" use_mesh="$(arg fixed_cam_use_mesh)">
    <origin xyz="${fixed_cam1_xyz}" rpy="${fixed_cam1_rpy}" />
  </xacro:sensor_d435i>

  <xacro:sensor_d435i parent="$(arg prefix)base_link" name="$(arg prefix)fixed_cam2_camera"
    use_nominal_extrinsics="true" use_mesh="$(arg fixed_cam_use_mesh)">
    <origin xyz="${fixed_cam2_xyz}" rpy="${fixed_cam2_rpy}" />
  </xacro:sensor_d435i>

  <!-- Two SincereFirst USB camera modules, same "Camera_module_for_design"
       STEP cluster as the two D435i's above (per the fixed_cam1_xyz/
       fixed_cam2_xyz history: their ORIGINAL placeholder position, before
       being moved for visual tuning in Gazebo, was
       "0.142000 (+-0.034949) 0.388500": exactly this cluster's
       bbox-center X/Z composed with the real measured USB-camera-pair Y
       spacing pulled from that same STEP file. That measured spacing is
       reused here verbatim for the actual USB cameras it always described;
       Z is the CURRENT (post-tuning) 0.378500 the D435i's now use, not the
       original 0.388500, per instruction.
       left/right per REP103 (forward=X, left=+Y, up=Z), using fixed_cam1
       (rpy=0, facing +X) as the "front" reference, not tied to
       fixed_cam1/fixed_cam2's own Y-sign convention, which predates this
       and was reassigned during their own tuning.
       No SincereFirst mesh is available in this repo (meshes/ only has
       extras_compressed.stl and xarm_mount_plate.stl): placeholder box
       geometry via usb_camera_macro below, sized for a generic small UVC
       board camera; swap in a real mesh/measured dimensions if/when
       available, same caveat as every other STEP-placeholder geometry in
       this file.
       rpy: facing sideways per instruction, not forward like fixed_cam1
       (an earlier revision defaulted both to rpy="0 0 0"/forward, absent
       any given orientation; corrected here). Yaw +-pi/2 redirects each
       camera's own local +X (forward) axis to world +-Y: REP103 has
       forward=X, left=+Y, so Rz(+pi/2) maps local +X to +Y (left) and
       Rz(-pi/2) maps it to -Y (right); left_camera looks toward the
       robot's left, right_camera toward its right, matching their names
       and fixed_cam1's own rpy=0/+X as the "front" reference direction. -->
  <xacro:property name="left_camera_xyz" value="0.142000 0.059898 0.390000" />
  <xacro:property name="right_camera_xyz" value="0.142000 -0.059898 0.390000" />
  <xacro:property name="left_camera_rpy" value="0 0 1.570796" />
  <xacro:property name="right_camera_rpy" value="0 0 -1.570796" />

  <!-- Generic UVC USB camera: link (placeholder box) + REP103 optical
       frame child, mirroring the physical-frame/optical-frame split
       realsense2_description's sensor_d435 macro uses above (see that
       macro's own depth_joint/depth_optical_joint pair) so this camera's
       image data lines up with the same convention downstream tooling
       (RViz, image_pipeline, etc.) already expects from a ROS camera. -->
  <xacro:macro name="usb_camera_macro" params="name parent *origin">
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${name}_link" />
    </joint>
    <link name="${name}_link">
      <visual>
        <!-- Roll +pi/2 about the link's own local X (its view direction,
             same axis ${name}_optical_joint derives the optical frame
             from): rotates the SHAPE only, not the link/joint/optical
             frame themselves, so the camera's actual mount orientation and
             TF are untouched by this. Box is (X=0.030, Y=0.020, Z=0.030)
             before this roll, so X (view direction, already correct) and Z
             (0.030, "long") swap with Y (0.020, "short"): since each
             camera's own mount joint above is a pure yaw (see
             left_camera_rpy/right_camera_rpy), un-rolled local Y maps to
             world's front-rear (X) axis and local Z to world-up, i.e.
             the SHORT edge would land front-rear and the LONG edge
             vertical. This roll swaps that: long edge -> front-rear axis,
             short edge -> vertical, per instruction. -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <!-- Placeholder dimensions (30x20x30mm): generic small UVC
               board-camera size estimate, not a measured SincereFirst
               spec. -->
          <box size="0.030 0.020 0.030" />
        </geometry>
        <material name="usb_camera_black">
          <color rgba="0.1 0.1 0.1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <box size="0.030 0.020 0.030" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.02" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
    <joint name="${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${name}_link" />
      <child link="${name}_optical_frame" />
    </joint>
    <link name="${name}_optical_frame" />
  </xacro:macro>

  <xacro:usb_camera_macro name="$(arg prefix)left_camera" parent="$(arg prefix)base_link">
    <origin xyz="${left_camera_xyz}" rpy="${left_camera_rpy}" />
  </xacro:usb_camera_macro>

  <xacro:usb_camera_macro name="$(arg prefix)right_camera" parent="$(arg prefix)base_link">
    <origin xyz="${right_camera_xyz}" rpy="${right_camera_rpy}" />
  </xacro:usb_camera_macro>

  <!-- Sensor tags only (no Sensors-system <plugin> block): realsense_gz
       (realsense.gazebo.xacro) bundles BOTH the per-camera sensor
       declarations AND the world-wide gz::sim::systems::Sensors plugin
       registration in one macro, so calling it here as-is per camera
       would (and, tested, did) re-register that system a 2nd and 3rd
       time on top of the wrist camera's own call inside xarm_device,
       hitting the exact same "Another item already exists with name:
       scene" Ogre2 crash tested_world.world's own duplicate copy caused
       earlier (see that file's comment). One Sensors registration
       (still xarm_device's, for the wrist camera) covers the whole
       simulation; these two only need the sensor tags themselves.
       Reference frame names below (camera_depth_frame, camera_infra1_frame,
       etc.) match realsense2_description's sensor_d435i naming (infra1/
       infra2), NOT xarm_description's own d435i_urdf naming (left_ir/
       right_ir) that this macro's sensor tag content was originally
       copied from, and mismatched once already (silently: gz-sim doesn't
       error on a <gazebo reference> pointing at a link that doesn't
       exist, it just drops that sensor, so fixed_cam1/2's infra1/infra2
       topics were simply missing with nothing in the log to explain why;
       caught by checking `gz topic -l` against the expected topic list
       rather than trusting a clean launch log alone). -->
  <xacro:macro name="fixed_cam_sensor_tags" params="prefix">
    <gazebo reference="${prefix}camera_depth_frame">
      <sensor name="${prefix}cameradepth" type="rgbd_camera">
        <camera name="${prefix}camera">
          <!-- Without this, gz-sim falls back to an auto-generated scoped
               entity path (e.g. 'robot_a/robot_a_base_link/robot_a_fixed_cam1_cameradepth')
               as the frame_id on every message this sensor publishes (image,
               depth image, points, camera_info), not a real TF frame, so
               RViz's PointCloud2/Image displays silently render nothing (no
               transform found), even fully enabled. See camera.sdf's own
               optical_frame_id element ("used in the camera_info message
               header", though it's actually applied to all this sensor's
               messages, not just camera_info; confirmed by echoing
               '.../depth/points's header.frame_id before/after this fix).

               Deliberately pointed at camera_depth_frame (the PHYSICAL,
               non-optical-rotated mount frame), NOT camera_depth_optical_frame
               despite that being the ROS/realsense2_camera-driver convention
               for a depth point cloud: verified empirically (dumped
               .../depth/points, transformed through TF into robot_a_odom,
               compared against tested_world.world's known wall/floor
               geometry) that gz-sim's rgbd_camera sensor (Harmonic, gz-sensors
               8.2.2) actually emits point-cloud XYZ in the SENSOR's own local/
               physical axes (X-forward, Z-up, matching camera_depth_frame),
               NOT the rotated X-right/Y-down/Z-forward optical convention its
               own "optical_frame_id" element name implies. Labeling it
               camera_depth_optical_frame (matching data already in the
               physical convention) made RViz apply that frame's extra
               rotation on top of already-correct data, throwing the cloud
               off (points ending up below the floor, etc). If a future
               gz-sensors version fixes this upstream (starts actually
               rotating point data into the optical frame to match what
               "optical_frame_id" implies), this will need to flip back to
               camera_depth_optical_frame: re-run the same empirical check
               (raw x/y/z stats vs. known nearby world geometry) rather than
               assuming either way. -->
          <optical_frame_id>${prefix}camera_depth_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.100</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}camera/depth</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_color_frame">
      <sensor name="${prefix}cameracolor" type="camera">
        <camera name="${prefix}camera">
          <!-- See the depth sensor's own comment above: same fix, same reason. -->
          <optical_frame_id>${prefix}camera_color_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <camera_info_topic>${prefix}camera/color/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>${prefix}camera/color/image_raw</topic>
        <enable_metrics>true</enable_metrics>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_infra1_frame">
      <sensor name="${prefix}cameraired1" type="camera">
        <camera name="${prefix}camera">
          <!-- See the depth sensor's own comment above: same fix, same reason. -->
          <optical_frame_id>${prefix}camera_infra1_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}camera/infra1/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}camera/infra1/image_raw</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_infra2_frame">
      <sensor name="${prefix}cameraired2" type="camera">
        <camera name="${prefix}camera">
          <!-- See the depth sensor's own comment above: same fix, same reason. -->
          <optical_frame_id>${prefix}camera_infra2_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}camera/infra2/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}camera/infra2/image_raw</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${_is_gz_sim}">
    <xacro:fixed_cam_sensor_tags prefix="$(arg prefix)fixed_cam1_" />
    <xacro:fixed_cam_sensor_tags prefix="$(arg prefix)fixed_cam2_" />
  </xacro:if>

  <!-- Wrist camera (Orbbec Gemini 2, software-side only for now: mesh
       stays the D435i+stand placeholder, see the header comment's own
       "software-side only" note and this session's mesh-recommendation
       discussion: no combined Gemini2+xArm-mount mesh exists, swapping it
       would drop the mount geometry entirely). Same wiring treatment as
       fixed_cam1/fixed_cam2 (correct optical_frame_id, own topics, bridged
       + real driver), applied to the wrist's EXISTING D435i frame chain
       (camera_link/camera_depth_frame/camera_color_frame/camera_left_ir_frame/
       camera_right_ir_frame, from xarm_device's add_realsense_d435i="true"
       above, itself unchanged): "lens distance similar, thickness differs"
       per instruction, i.e. treat it as a D435i-shaped stand-in for now.

       Deliberately NOT editing xarm_ros2/xarm_description/urdf/camera/
       realsense.gazebo.xacro to add its own missing optical_frame_id (the
       same bug fixed_cam_sensor_tags' own comment above documents) :
       xarm_ros2 is a git submodule (this repo's own established practice
       already avoids touching it, see xarm_device's add_gripper comment
       above), and add_d435i_links (default true, unchanged) ties "create
       these frames" and "register xarm's own broken sensor tags for them"
       to the same flag with no way to get one without the other. Instead:
       this macro adds a SEPARATE, correctly-configured sensor set on the
       SAME existing frames, with distinct sensor names/topics (no
       collision with xarm's own "${prefix}camera..." ones): xarm's own
       copy keeps running unused/unbridged alongside (a real but accepted
       small extra render cost, one wrist camera, in exchange for not
       touching the submodule). No new Sensors-system plugin registration
       needed: xarm's own realsense_gz call (still active, add_d435i_links
       unchanged) already registered it once, same reason
       fixed_cam_sensor_tags' own sensor tags don't re-register it either. -->
  <xacro:macro name="wrist_camera_sensor_tags" params="prefix">
    <gazebo reference="${prefix}camera_depth_frame">
      <sensor name="${prefix}wristcameradepth" type="rgbd_camera">
        <camera name="${prefix}wristcamera">
          <!-- Physical, not optical, frame: same gz-sim rgbd_camera
               point-cloud convention quirk as fixed_cam_sensor_tags' own
               depth sensor above: see that comment for the full
               empirical verification. Same gz-sensors version, same
               sensor type, so the same fix applies here without needing
               to re-derive it, though this specific sensor's point cloud
               hasn't been separately re-verified against known world
               geometry the way fixed_cam1's was. -->
          <optical_frame_id>${prefix}camera_depth_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.100</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}wrist_camera/depth</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_color_frame">
      <sensor name="${prefix}wristcameracolor" type="camera">
        <camera name="${prefix}wristcamera">
          <optical_frame_id>${prefix}camera_color_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <camera_info_topic>${prefix}wrist_camera/color/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>${prefix}wrist_camera/color/image_raw</topic>
        <enable_metrics>true</enable_metrics>
      </sensor>
    </gazebo>
    <!-- Reference links are camera_left_ir_frame/camera_right_ir_frame
         (xarm_description's own d435i_urdf naming), but topics/optical
         frames below still say "infra1"/"infra2": matching xarm's own
         realsense_gz macro's identical left=infra1/right=infra2 convention
         (and fixed_cam_sensor_tags'), so downstream consumers see the same
         topic shape regardless of which camera it's from. -->
    <gazebo reference="${prefix}camera_left_ir_frame">
      <sensor name="${prefix}wristcameraired1" type="camera">
        <camera name="${prefix}wristcamera">
          <optical_frame_id>${prefix}camera_left_ir_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}wrist_camera/infra1/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}wrist_camera/infra1/image_raw</topic>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}camera_right_ir_frame">
      <sensor name="${prefix}wristcameraired2" type="camera">
        <camera name="${prefix}wristcamera">
          <optical_frame_id>${prefix}camera_right_ir_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
          <camera_info_topic>${prefix}wrist_camera/infra2/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>${prefix}wrist_camera/infra2/image_raw</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${_is_gz_sim}">
    <xacro:wrist_camera_sensor_tags prefix="$(arg prefix)" />
  </xacro:if>

  <!-- Plain single-image gz sensor for one usb_camera_macro instance
       (left_camera/right_camera): same structure as fixed_cam_sensor_tags'
       own color block above, just parameterized by 'name' instead of
       hardcoding "camera" (usb_camera_macro's links are named
       "${name}_link"/"${name}_optical_frame" directly, not
       "${prefix}camera_..." like sensor_d435i's convention). Placeholder
       resolution/FOV (1280x720, 1.57rad) matching the D435i color stream
       above pending real SincereFirst datasheet values. -->
  <xacro:macro name="usb_camera_sensor_tags" params="name">
    <gazebo reference="${name}_link">
      <sensor name="${name}sensor" type="camera">
        <camera name="${name}">
          <optical_frame_id>${name}_optical_frame</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <camera_info_topic>${name}/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>${name}/image_raw</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${_is_gz_sim}">
    <xacro:usb_camera_sensor_tags name="$(arg prefix)left_camera" />
    <xacro:usb_camera_sensor_tags name="$(arg prefix)right_camera" />
  </xacro:if>

  <!-- Sim-only depth-test target: a tall, slim, world-upright cylinder,
       0.5m straight out from fixed_cam1's own lens, for visually/
       numerically verifying that camera's point cloud alignment (an
       asymmetric-enough, unambiguous target: unlike tested_world.world's
       flat, left-right-symmetric wall, which can't reveal certain bugs,
       e.g. a mirror flip, since it looks the same either way).
       Parented directly to fixed_cam1_camera_link (NOT base_link) so "0.5m
       in front of the camera" stays literally true regardless of where
       fixed_cam1_xyz/rpy above end up being tuned to. xyz="0.5 0 0" is
       exactly the "camera forward" axis in that link's own physical
       (non-optical) convention: the same X-forward convention this
       package's point-cloud optical_frame_id fix (fixed_cam_sensor_tags'
       depth sensor, above) is keyed to, so a correctly-calibrated point
       cloud should show this cylinder's surface at very close to x=0.5m in
       the raw (sensor-local) depth data.
       rpy="0 0 0" (no counter-rotation) relies on fixed_cam1_xyz/rpy only
       ever applying pure YAW (0 or pi so far, see fixed_cam1_rpy/
       fixed_cam2_rpy above): yaw alone keeps a cylinder's own Z axis
       aligned with world Z (upright) regardless of heading, so this only
       needs revisiting if a fixed camera ever gets pitch/roll added.
       Visual only (no <collision>): a depth/rgbd camera sensor renders
       from the visual mesh, not physics collision, so collision geometry
       would add self-collision computation for zero benefit here. Debug
       aid only: gated on _is_gz_sim so it never appears on the real
       robot's model. -->
  <xacro:if value="${_is_gz_sim}">
    <xacro:property name="cam1_test_target_radius" value="0.025" />
    <xacro:property name="cam1_test_target_height" value="1.0" />
    <link name="$(arg prefix)fixed_cam1_test_target_link">
      <visual>
        <geometry>
          <cylinder radius="${cam1_test_target_radius}" length="${cam1_test_target_height}" />
        </geometry>
        <material name="test_target_orange">
          <color rgba="1.0 0.5 0.0 1" />
        </material>
      </visual>
      <inertial>
        <mass value="0.05" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>
    <joint name="$(arg prefix)fixed_cam1_test_target_joint" type="fixed">
      <parent link="$(arg prefix)fixed_cam1_camera_link" />
      <child link="$(arg prefix)fixed_cam1_test_target_link" />
      <origin xyz="0.5 0 0" rpy="0 0 0" />
    </joint>
  </xacro:if>

  <!-- State-only ros2_control interface for the base's 4 steering + 4 wheel
       joints (see ranger_mini_v3.xacro's own header comment: they're left
       passive, no command interface / drive plugin; driving the base is
       still separate follow-up work, unchanged by this). Without any
       ros2_control interface, nothing ever published these joints' state,
       so robot_state_publisher had no value for them and couldn't compute
       their TF: RViz's RobotModel display then has no transform for the
       wheel/steering links and hides them entirely (not just "not moving",
       genuinely absent). Declaring them here with state_interface only (no
       command_interface, no new controller) lets gz_ros2_control's
       GazeboSimSystem report their actual simulated pose, picked up by
       the same joint_state_broadcaster the arm already uses (it publishes
       every joint from every claimed hardware interface by default, see
       config/ros2_controllers.yaml: no 'joints' list there means "all of
       them"), so the wheels/steering render (static, since nothing drives
       them yet) instead of disappearing. Real hardware isn't affected:
       this whole block is gz-sim-only (_is_gz_sim), same as the plugin
       block above.
  -->
  <xacro:if value="${_is_gz_sim}">
    <ros2_control name="RangerBaseState" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:macro name="_passive_wheel_joint" params="name">
        <joint name="$(arg prefix)${name}">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:_passive_wheel_joint name="fl_steering_joint"/>
      <xacro:_passive_wheel_joint name="fl_wheel"/>
      <xacro:_passive_wheel_joint name="fr_steering_joint"/>
      <xacro:_passive_wheel_joint name="fr_wheel"/>
      <xacro:_passive_wheel_joint name="rl_steering_joint"/>
      <xacro:_passive_wheel_joint name="rl_wheel"/>
      <xacro:_passive_wheel_joint name="rr_steering_joint"/>
      <xacro:_passive_wheel_joint name="rr_wheel"/>
    </ros2_control>
  </xacro:if>

  <!-- F/T SENSOR (Gazebo simulation only): simulated physics force/torque
       measurement at joint6. This is the sim-side sensor plugin, separate
       from model1300="true" above (which swaps in the F/T-sensor-equipped
       tool-flange MESH); the physical accessory's presence, previously
       flagged here as unconfirmed, is now confirmed by
       RM_Version_1.2_production.step's arm node itself being named
       "xArm6(XI1300)_02022023". On actual hardware this comes from that
       accessory via ranger_xarm6.launch.py's sim:=false path (remaps
       'uf_ftsensor_ext_states'). Mirrors the same gz-sim force_torque
       sensor + flat 'force_torque' topic convention robotnik_description
       uses at UR5e's wrist_3 for Theron/Kairos (see rbtheron_plus.urdf.xacro),
       so wbc.py's force_torque_callback needs no changes either way. -->
  <xacro:if value="${_is_gz_sim}">
    <gazebo reference="$(arg prefix)joint6">
      <sensor name="force_torque_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>500</update_rate>
        <visualize>true</visualize>
        <topic>force_torque</topic>
        <force_torque>
          <frame>sensor</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>
