<?xml version="1.0" ?>
<!--
  Ground plane + a physical contact wall (real collision geometry, not just
  an RViz marker) for force-control testing. Originally from Robotnik's
  robotnik_gazebo_ignition package (now removed from this branch; see
  main branch for the Theron/Kairos setup); copied here so Ranger Mini 3 +
  xArm6 keeps the same test environment without that dependency.

  World name 'robotnik_simple' is kept as-is: wbc_visualize.py's
  move_to_init() Gazebo pose-reset still hardcodes this name in its
  `gz service -s /world/robotnik_simple/set_pose` call.
-->
<sdf version="1.9">
  <world name='robotnik_simple'>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>world</type>
          <iters>150</iters> 
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>false</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1e-5</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <!-- gz::sim::systems::Sensors is NOT declared here: ranger_xarm6_description's
         xarm_device now adds add_realsense_d435i="true" (the arm's wrist
         camera), and xarm_description's realsense_gz macro already emits its
         own copy of this exact plugin (also render_engine=ogre2) as part of
         the robot's own SDF. Loading Sensors twice (once here, once from the
         robot) crashes gz-sim on startup: Ogre2 throws
         "Another item already exists with name: scene" and aborts, so
         there must be exactly one copy; the robot-provided one is now it. If
         the camera is ever removed from the robot and something else in this
         world needs rendered sensors again, this plugin needs to come back. -->
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>
    <plugin name="gz::sim::systems::Contact" filename="libgz-sim-contact-system.so"/>
    <plugin name="gz::sim::systems::ForceTorque" filename="libgz-sim-forcetorque-system.so"/>

    <scene>
      <ambient>1 1 1</ambient>
      <grid>false</grid>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 -1.3 0 0.5</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.01 0.01 0.01 1</specular>
      <intensity>2</intensity>
      <visualize>false</visualize>
    </light>

    <!-- <include>
      <uri>model://aruco_marker_0</uri>
      <name>aruco_marker_0</name>
      <pose>2.84 4.9 1.3 0 1.5708 0</pose>
    </include> -->

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall">
      <static>true</static>
      <pose>3 0 1.0 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.3 2.0</size>
            </box>
          </geometry>
          <surface>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>100</kd>
                <min_depth>0.0001</min_depth>
                <max_vel>0.01</max_vel>
              </ode>
            </contact>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.3 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.8 1</ambient>
            <diffuse>0.3 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>