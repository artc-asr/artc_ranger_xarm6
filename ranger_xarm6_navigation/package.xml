<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_xarm6_navigation</name>
  <version>0.1.0</version>
  <description>Odometry, mapping, localization and navigation for the Ranger Mini 3.0 + xArm6.</description>
  <maintainer email="thinkminator1024@gmail.com">wbcc_mm maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>livox_ros_driver2</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>fast_lio</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
