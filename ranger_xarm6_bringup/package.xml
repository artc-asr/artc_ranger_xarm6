<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_xarm6_bringup</name>
  <version>0.1.0</version>
  <description>One launch for the whole Ranger Mini 3.0 + xArm6 sim stack (robot, Nav2, MoveIt, tasks), viewed in Foxglove and klein-bt.</description>
  <maintainer email="thinkminator1024@gmail.com">wbcc_mm maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ranger_xarm6_description</exec_depend>
  <exec_depend>ranger_xarm6_navigation</exec_depend>
  <exec_depend>ranger_xarm6_manipulation</exec_depend>
  <exec_depend>ranger_xarm6_tasks</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
